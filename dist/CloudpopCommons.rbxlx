      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[local Economy = {}

function Economy.defaults()
	return {
		version = 1,
		pesos = 0,
		rounds = 0,
		owned = { marker_sun = true, card_cloud = true },
		equipped = { marker = "marker_sun", card = "card_cloud" },
		chest = { lastClaimAt = 0, lastClaimKey = "", claims = 0, rewardUnits = 0 },
		payoutOutbox = {},
		settings = { autoMark = false, reducedMotion = false, musicVolume = 0.5, voiceVolume = 0.8, sfxVolume = 0.7 },
	}
end

function Economy.find(catalog, id)
	for _, item in ipairs(catalog) do
		if item.id == id then
			return item
		end
	end
	return nil
end

local function nonnegativeInteger(value)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return 0
	end
	return math.clamp(math.floor(value), 0, 1000000000)
end

function Economy.normalize(raw, catalog)
	local profile = Economy.defaults()
	if type(raw) ~= "table" then
		return profile
	end
	profile.pesos = nonnegativeInteger(raw.pesos)
	profile.rounds = nonnegativeInteger(raw.rounds)
	for _, item in ipairs(catalog) do
		if type(raw.owned) == "table" and raw.owned[item.id] == true then
			profile.owned[item.id] = true
		end
	end
	for _, category in ipairs({ "marker", "card", "pet" }) do
		local id = if type(raw.equipped) == "table" then raw.equipped[category] else nil
		local item = Economy.find(catalog, id)
		if item and item.category == category and profile.owned[id] then
			profile.equipped[category] = id
		end
	end
	if type(raw.chest) == "table" then
		for _,key in ipairs({"lastClaimAt","claims","rewardUnits"}) do profile.chest[key]=nonnegativeInteger(raw.chest[key]) end
		-- Timestamps need the epoch range rather than the legacy currency cap.
		local at=raw.chest.lastClaimAt
		if type(at)=="number" and at%1==0 and at>=0 and at<=9999999999 then profile.chest.lastClaimAt=at end
		if type(raw.chest.lastClaimKey)=="string" and #raw.chest.lastClaimKey<=40 then profile.chest.lastClaimKey=raw.chest.lastClaimKey end
	end
	if type(raw.payoutOutbox)=="table" then
		for _,entry in ipairs(raw.payoutOutbox) do
			if #profile.payoutOutbox>=2048 then break end
			if type(entry)=="table" and type(entry.id)=="string" and #entry.id<=39
				and type(entry.playerName)=="string" and #entry.playerName<=30
				and type(entry.source)=="string" and #entry.source<=60
				and type(entry.multiplier)=="string" and #entry.multiplier<=1025
				and type(entry.userId)=="number" and entry.userId%1==0 and entry.userId>0
				and type(entry.at)=="number" and entry.at%1==0 and entry.at>0
				and type(entry.pesos)=="number" and entry.pesos%1==0 and entry.pesos>0 and entry.pesos<=1000000000 then
				table.insert(profile.payoutOutbox,{id=entry.id,userId=entry.userId,playerName=entry.playerName,
					source=entry.source,multiplier=entry.multiplier,pesos=entry.pesos,at=entry.at,test=entry.test==true})
			end
		end
	end
	if type(raw.settings) == "table" then
		profile.settings.autoMark = raw.settings.autoMark == true
		profile.settings.reducedMotion = raw.settings.reducedMotion == true
		for _, key in ipairs({ "musicVolume", "voiceVolume", "sfxVolume" }) do
			local value = raw.settings[key]
			if type(value) == "number" and value == value and math.abs(value) < math.huge then
				profile.settings[key] = math.clamp(value, 0, 1)
			end
		end
	end
	return profile
end

function Economy.unequipPet(profile)
	profile.equipped.pet=nil
	return true,"Pet unequipped."
end
function Economy.purchase(profile, catalog, id)
	if type(id) ~= "string" then
		return false, "Unknown item."
	end
	local item = Economy.find(catalog, id)
	if not item then
		return false, "Unknown item."
	end
	if profile.owned[id] then
		profile.equipped[item.category] = id
		return true, item.name .. " equipped."
	end
	if profile.pesos < item.price then
		return false, "Save " .. (item.price - profile.pesos) .. " more Pesos for " .. item.name .. "."
	end
	profile.pesos -= item.price
	profile.owned[id] = true
	profile.equipped[item.category] = id
	return true, item.name .. " purchased and equipped."
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ExactInteger</string>
          <string name="Source"><![CDATA[-- Exact signed decimal arithmetic for bonus calculations. Never convert large values to doubles.
-- 1024 digits is a storage/resource guard, NOT a Go CRazy prize-design cap.
local Exact = { MaxDigits = 1024 }
function Exact.normalize(value)
	assert(type(value) == "string" and #value <= Exact.MaxDigits + 1, "Decimal string required (up to 1024 digits)")
	assert(string.match(value, "^%-?%d+$"), "Integer multiplier required; fractional rules are not configured")
	local negative = string.sub(value, 1, 1) == "-"
	local digits = if negative then string.sub(value, 2) else value
	digits = string.gsub(digits, "^0+", "")
	if digits == "" then return "0" end
	assert(#digits <= Exact.MaxDigits, "Decimal resource limit exceeded")
	return (if negative then "-" else "") .. digits
end
function Exact.multiplySmall(value, factor)
	value = Exact.normalize(value)
	assert(type(factor) == "number" and factor % 1 == 0 and factor >= 0 and factor <= 1000000, "Invalid base amount")
	local negative = string.sub(value, 1, 1) == "-"
	local digits = if negative then string.sub(value, 2) else value
	local result, carry = {}, 0
	for index = #digits, 1, -1 do
		local product = tonumber(string.sub(digits, index, index)) * factor + carry
		table.insert(result, tostring(product % 10))
		carry = math.floor(product / 10)
	end
	while carry > 0 do table.insert(result, tostring(carry % 10)); carry = math.floor(carry / 10) end
	local reversed = {}
	for index = #result, 1, -1 do table.insert(reversed, result[index]) end
	return Exact.normalize((if negative then "-" else "") .. table.concat(reversed))
end
function Exact.format(value)
	value = Exact.normalize(value)
	local sign = if string.sub(value, 1, 1) == "-" then "−" else ""
	local digits = if sign ~= "" then string.sub(value, 2) else value
	if #digits > 15 then return sign .. string.sub(digits, 1, 1) .. "." .. string.sub(digits, 2, 4) .. "e+" .. (#digits - 1) end
	local reversed = string.reverse(digits)
	local groups = string.gsub(reversed, "(%d%d%d)", "%1,")
	return sign .. string.gsub(string.reverse(groups), "^,", "")
end
return Exact
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GameRules</string>
          <string name="Source"><![CDATA[-- Pure round rules. Randomness is injected by the server, never by a client.
local Rules = {}
function Rules.isIndex(value, maximum)
	return type(value) == "number" and value == value and value % 1 == 0 and value >= 1 and value <= maximum
end
function Rules.shuffle(count, random)
	local result = {}
	for value = 1, count do result[value] = value end
	for index = count, 2, -1 do
		local other = random(1, index)
		result[index], result[other] = result[other], result[index]
	end
	return result
end
function Rules.cardMultiplier(weights, random)
	assert(#weights == 20, "Provide weights for multipliers 1 through 20")
	local total = 0
	for _, weight in ipairs(weights) do
		assert(type(weight) == "number" and weight >= 0 and weight <= 1000000 and weight % 1 == 0, "Invalid card multiplier weight")
		total += weight
	end
	assert(total > 0, "At least one multiplier must be possible")
	local roll = random(1, total)
	for multiplier, weight in ipairs(weights) do
		roll -= weight
		if roll <= 0 then return multiplier end
	end
	error("Invalid random source")
end
-- Apply once to this card's eligible MAIN reward only. No production base/pattern is assumed.
function Rules.claimMainReward(state, cardIndex, base, eligible)
	if state.settled or not eligible or not Rules.isIndex(cardIndex, #state.cards) or state.claimed[cardIndex] then return nil end
	assert(type(base) == "number" and base % 1 == 0 and base >= 0 and base <= 1000000, "Invalid main base reward")
	local reward = base * state.multipliers[cardIndex]
	state.claimed[cardIndex] = true
	return reward
end
function Rules.newCardState(config, random)
	local state = { cards = {}, marks = {}, multipliers = {}, claimed = {}, bonuses = {}, participated = false, settled = false }
	-- Dealing/marking is independent of the still-unconfirmed pattern rewards.
	if config.Main.CardsEnabled then
		assert(Rules.isIndex(config.Main.Count, 8), "Confirm a main card count from 1 to 8")
		for index = 1, config.Main.Count do
			local deck, card = Rules.shuffle(config.NumberPool, random), {}
			for cell = 1, 25 do card[cell] = if cell == 13 and config.Main.FreeCenter then 0 else deck[cell] end
			state.cards[index], state.marks[index] = card, { [0] = true }
			state.multipliers[index] = Rules.cardMultiplier(config.Main.MultiplierWeights, random)
		end
	end
	for _, definition in ipairs(config.Bonuses) do
		local numbers, deck = {}, Rules.shuffle(config.NumberPool, random)
		for index = 1, definition.count do numbers[index] = deck[index] end
		state.bonuses[definition.id] = { numbers = numbers, progress = 0, qualified = false }
	end
	return state
end
function Rules.mark(state, drawn, cardIndex, cellIndex)
	if state.settled or not Rules.isIndex(cardIndex, #state.cards) or not Rules.isIndex(cellIndex, 25) then return false end
	local number = state.cards[cardIndex][cellIndex]
	if not drawn[number] or state.marks[cardIndex][number] then return false end
	state.marks[cardIndex][number], state.participated = true, true
	return true
end
function Rules.markAll(state, drawn)
	if state.settled then return end
	for index,card in ipairs(state.cards) do
		for _,number in ipairs(card) do if drawn[number] then state.marks[index][number]=true end end
	end
end
function Rules.qualify(state, drawn)
	local newlyQualified = {}
	for id, card in pairs(state.bonuses) do
		local progress = 0
		for _, number in ipairs(card.numbers) do if drawn[number] then progress += 1 end end
		card.progress = progress
		if #card.numbers > 0 and progress == #card.numbers and not card.qualified then
			card.qualified = true
			table.insert(newlyQualified, id)
		end
	end
	return newlyQualified
end
function Rules.settle(state, rewards)
	if state.settled then return nil end
	state.settled = true
	return { total = if state.participated then rewards.Participation else 0, bonusPending = true }
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">PayoutRules</string>
          <string name="Source"><![CDATA[-- The active economy uses exact bounded integers. Huge/signed bonus-ledger integration is pending.
local Rules={Window=86400}
function Rules.valid(record, now)
	return type(record)=="table" and type(record.id)=="string" and #record.id>0 and #record.id<=39
		and string.match(record.id,"^[%w_%-]+$")~=nil
		and type(record.userId)=="number" and record.userId%1==0 and record.userId>0
		and type(record.playerName)=="string" and #record.playerName<=30
		and string.match(record.playerName,"^[%w_]+$")~=nil
		and type(record.source)=="string" and #record.source>0 and #record.source<=60
		and type(record.multiplier)=="string" and #record.multiplier<=1025 and string.match(record.multiplier,"^%-?%d+$")~=nil
		and type(record.pesos)=="number" and record.pesos%1==0 and record.pesos>0 and record.pesos<=1000000000
		and type(record.at)=="number" and record.at%1==0 and record.at<=now and record.at>now-Rules.Window
		and record.test~=true
end
function Rules.better(a,b)
	if not b then return true end
	if a.pesos~=b.pesos then return a.pesos>b.pesos end
	if a.at~=b.at then return a.at<b.at end
	return a.id<b.id
end
function Rules.leader(records, now)
	local best,seen=nil,{}
	for _,record in ipairs(records) do
		if not seen[record.id] and Rules.valid(record,now) then
			seen[record.id]=true
			if Rules.better(record,best) then best=record end
		end
	end
	return best
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PetBuilder</string>
          <string name="Source"><![CDATA[-- Three original geometric companions, no external models or franchise assets.
local Pet = {}
function Pet.build(id)
	local model=Instance.new("Model")
	model.Name=id
	local function part(name,size,position,color,shape)
		local item=Instance.new("Part")
		item.Name,item.Size,item.Position=name,Vector3.new(table.unpack(size)),Vector3.new(table.unpack(position))
		item.Color,item.Material=Color3.fromRGB(table.unpack(color)),Enum.Material.SmoothPlastic
		item.Anchored,item.CanCollide,item.CanTouch,item.CanQuery,item.CastShadow=true,false,false,false,false
		if shape then item.Shape=shape end
		item.Parent=model
		return item
	end
	local primary
	if id=="pet_lumen" then
		primary=part("Body",{1.8,1,1.2},{0,0,0},{131,223,239})
		part("Crown",{0.7,0.4,0.7},{0,0.7,0},{246,223,139})
		for _,side in ipairs({-1,1}) do part("Sail",{0.25,0.9,0.7},{side*1.1,0.2,0},{219,242,255}) end
	elseif id=="pet_prism" then
		primary=part("Body",{1.2,1.2,1.2},{0,0,0},{179,176,244})
		for index=1,3 do
			local orb=part("Orbit"..index,{0.45,0.45,0.45},{math.cos(index*2.1)*1.05,0.5,math.sin(index*2.1)*0.6},{150,225,243},Enum.PartType.Ball)
			orb.Transparency=0.1
		end
	elseif id=="pet_tassel" then
		primary=part("Body",{1.2,1.5,1.1},{0,0.2,0},{127,201,183},Enum.PartType.Ball)
		for _,side in ipairs({-1,0,1}) do part("Ribbon",{0.2,0.8,0.25},{side*0.4,-0.75,0},{206,243,235}) end
	else error("Unknown pet") end
	for _,side in ipairs({-1,1}) do part("Eye",{0.13,0.16,0.09},{side*0.28,0.15,-0.61},{20,36,64}) end
	part("Smile",{0.25,0.06,0.08},{0,-0.12,-0.62},{20,36,64})
	model.PrimaryPart=primary
	return model
end
return Pet
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">CloudpopServer</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">CardHolder</string>
          <string name="Source"><![CDATA[-- Server-created tool replicates to everybody. It never changes camera or movement.
local CardHolder = {}
function CardHolder.give(player)
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack or not player.Parent then return end
	if backpack:FindFirstChild("Cards") or (player.Character and player.Character:FindFirstChild("Cards")) then return end
	local tool = Instance.new("Tool")
	tool.Name, tool.ToolTip, tool.CanBeDropped = "Cards", "Open your cards", false
	local handle = Instance.new("Part")
	handle.Name, handle.Size = "Handle", Vector3.new(1.65, 2, 0.16)
	handle.Color, handle.Material = Color3.fromRGB(26, 58, 99), Enum.Material.SmoothPlastic
	handle.CanCollide, handle.Massless, handle.Parent = false, true, tool
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local surface = Instance.new("SurfaceGui")
		surface.Face, surface.CanvasSize, surface.Parent = face, Vector2.new(165, 200), handle
		local title = Instance.new("TextLabel")
		title.Size, title.BackgroundTransparency = UDim2.new(1, 0, 0, 35), 1
		title.Text, title.TextSize, title.Font = "CLOUDPOP", 16, Enum.Font.GothamBold
		title.TextColor3, title.Parent = Color3.fromRGB(222, 241, 255), surface
		for index = 1, 25 do
			local cell = Instance.new("Frame")
			cell.Size = UDim2.fromOffset(23, 23)
			cell.Position = UDim2.fromOffset(14 + (index - 1) % 5 * 28, 40 + math.floor((index - 1) / 5) * 28)
			cell.BackgroundColor3, cell.BorderSizePixel = Color3.fromRGB(120, 198, 225), 0
			cell.Parent = surface
		end
	end
	tool.Parent = backpack
end
return CardHolder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">GameServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Cloudpop")
local Config = require(Shared.Config)
local Rules = require(Shared.GameRules)
local Manifest = require(Shared.AudioManifest)
local Economy = require(Shared.Economy)
local Profiles = require(script.Parent.ProfileStore)
local Holder = require(script.Parent.CardHolder)
local Marketplace = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ChestRules = require(Shared.ChestRules)
local Pass = require(script.Parent.PassService).new(Marketplace, Config.AutoMarkPass, os.clock)
local Pets = require(script.Parent.PetService).new(require(Shared.PetBuilder), workspace)
local Feed = require(script.Parent.ResultFeed).new(os.time)
local Global = require(script.Parent.GlobalPayouts).new(function(record) Feed:record(record) end)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = Shared
local action = Instance.new("RemoteEvent")
action.Name = "Action"
action.Parent = remotes
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "State"
stateEvent.Parent = remotes

-- Publish networking before constructing scenery, so a scene error cannot hide the protocol.
require(script.Parent.Workshop).build()
local rng = Random.new()
local function nextInteger(low, high) return rng:NextInteger(low, high) end
local profiles, boards, summaries, rateLimits, loading, characterConnections = {}, {}, {}, {}, {}, {}
local round = { id = 0, phase = "Waiting", deadline = 0, history = {}, drawn = {}, announcement = nil, announcementId = 0 }
local closing = false

local function usable(player)
	return Profiles.writable(profiles[player])
end

local function changed(profile)
	profile.revision = (profile.revision or 0) + 1
	if not profile.practice then profile.saveStatus = "Changes waiting to save" end
end

local function enqueueCommitted(profile, snapshot)
	for _,record in ipairs(snapshot.payoutOutbox or {}) do
		Global:submit(record, function()
			if profile.closing then return end
			for index,entry in ipairs(profile.data.payoutOutbox) do
				if entry.id==record.id then table.remove(profile.data.payoutOutbox,index);changed(profile);break end
			end
		end)
	end
end
Profiles.onSaved = enqueueCommitted

local function send(player, notice)
	local profile = profiles[player]
	if not profile or player.Parent ~= Players then return end
	local board = boards[player]
	local cardViews = {}
	if board then
		for cardIndex, card in ipairs(board.cards) do
			local cells = {}
			for _, number in ipairs(card) do
				table.insert(cells, { number = number, marked = board.marks[cardIndex][number] == true,
					available = round.drawn[number] == true })
			end
			table.insert(cardViews, { cells = cells, multiplier = board.multipliers[cardIndex] })
		end
	end
	local bonusViews = {}
	for _, definition in ipairs(Config.Bonuses) do
		local card = board and board.bonuses[definition.id]
		local cells = {}
		if card then
			for _, number in ipairs(card.numbers) do
				table.insert(cells, { number = number, marked = round.drawn[number] == true })
			end
		end
		table.insert(bonusViews, { id = definition.id, name = definition.name, cells = cells,
			progress = if card then card.progress else 0, target = definition.count,
			qualified = card and card.qualified == true, pending = true })
	end
	-- Future draws and other players' profiles never leave the server.
	stateEvent:FireClient(player, {
		roundId = round.id, phase = round.phase, deadline = round.deadline,
		history = round.history, drawCount = Config.DrawCount, cards = cardViews,
		announcement = round.announcement, activeBonus = nil, bonuses = bonusViews, mainPending = not Config.Main.RewardsConfirmed, bonusPending = true,
		participated = if board then board.participated else false,
		pesos = profile.data.pesos, rounds = profile.data.rounds,
		owned = profile.data.owned, equipped = profile.data.equipped, settings = profile.data.settings,
		saveStatus = profile.saveStatus, practice = profile.practice,
		pass = Pass:view(player), chest = ChestRules.status(profile.data.chest, Config.Chest, os.time()),
		topPayout = Global:view(), recentBonuses = Feed.recent, systemMessages = Feed.messages,
		players = #Players:GetPlayers(), summary = summaries[player], notice = notice,
	})
end

local function broadcast()
	for player in pairs(profiles) do send(player) end
end

local function settle(player)
	local board, profile = boards[player], profiles[player]
	if not board or not profile or not usable(player) then return end
	-- Opening cards and leaving before the first draw is not a played round.
	if #round.history == 0 then return end
	local summary = Rules.settle(board, Config.Rewards)
	if not summary then return end
	local credited = math.min(summary.total, 1000000000-profile.data.pesos)
	profile.data.pesos += credited
	summary.total = credited
	if credited>0 and not profile.practice and not RunService:IsStudio() then
		-- The credit and its transaction enter the SAME durable profile write.
		for index=#profile.data.payoutOutbox,1,-1 do
			local record=profile.data.payoutOutbox[index]
			if type(record.at)~="number" or record.at<=os.time()-86400 then table.remove(profile.data.payoutOutbox,index) end
		end
		table.insert(profile.data.payoutOutbox,{id=HttpService:GenerateGUID(false),userId=player.UserId,
			playerName=player.Name,source="Round participation",multiplier="1",pesos=credited,at=os.time()})
	end
	if board.participated then profile.data.rounds += 1 end
	changed(profile)
	summaries[player] = summary
end

local function addPlayer(player)
	if profiles[player] or loading[player] or closing then return end
	loading[player] = true
	local profile, problem = Profiles.load(player)
	loading[player] = nil
	if not profile then
		if player.Parent == Players then player:Kick(problem) end
		return
	end
	if player.Parent ~= Players or closing then
		Profiles.close(profile)
		return
	end
	profiles[player] = profile
	if not profile.practice then enqueueCommitted(profile, profile.data) end
	Pets:sync(player, profile.data.equipped.pet)
	task.spawn(function() Pass:check(player); send(player) end)
	characterConnections[player] = player.CharacterAdded:Connect(function() task.spawn(Holder.give, player) end)
	task.spawn(Holder.give, player)
	if round.phase == "Intermission" then
		boards[player] = Rules.newCardState(Config, nextInteger)
	end
	broadcast()
end

local function removePlayer(player)
	local profile = profiles[player]
	if profile then
		-- Earned progress is settled even if a player leaves before the results screen.
		settle(player)
		Profiles.close(profile)
	end
	Pets:remove(player)
	Pass:forget(player)
	if characterConnections[player] then characterConnections[player]:Disconnect(); characterConnections[player] = nil end
	profiles[player], boards[player], summaries[player], rateLimits[player] = nil, nil, nil, nil
	broadcast()
end

action.OnServerEvent:Connect(function(player, name, a, b, c, requestedRound)
	if type(name) ~= "string" or not profiles[player] then return end
	local now = os.clock()
	local budget = rateLimits[player] or { tokens = 16, at = now }
	budget.tokens = math.min(16, budget.tokens + (now - budget.at) * 8)
	budget.at = now
	rateLimits[player] = budget
	if budget.tokens < 1 then return end
	budget.tokens -= 1
	if name == "Sync" then send(player); return end
	if not usable(player) then send(player, "Saving is reconnecting. Please wait."); return end
	local profile, board = profiles[player], boards[player]
	local notice
	if name == "RefreshPass" then
		task.spawn(function() Pass:check(player);send(player) end)
	elseif name == "UnequipPet" then
		Economy.unequipPet(profile.data);Pets:sync(player,nil);changed(profile)
		notice = "Pet unequipped."
	elseif name == "ClaimChest" then
		local claimed,message = ChestRules.claim(profile.data.chest, Config.Chest, os.time())
		notice=message
		if claimed then changed(profile); task.spawn(function() Profiles.save(profile,false);send(player) end) end
	elseif name == "Cosmetic" then
		local bought, message = Economy.purchase(profile.data, Config.Catalog, a)
		if bought then changed(profile);Pets:sync(player,profile.data.equipped.pet) end
		notice = message
	elseif name == "Setting" then
		if a == "autoMark" then
			if type(b)~="boolean" or (b and not Pass:owns(player)) then send(player,"Auto Mark requires verified pass ownership.");return end
			if b and board and not board.settled and (round.phase=="Drawing" or round.phase=="LastCall") then Rules.markAll(board, round.drawn) end
		elseif a == "reducedMotion" then
			if type(b) ~= "boolean" then return end
		elseif a == "musicVolume" or a == "voiceVolume" or a == "sfxVolume" then
			if type(b) ~= "number" or b ~= b or b < 0 or b > 1 then return end
		else return end
		profile.data.settings[a] = b
		changed(profile)
	elseif board and requestedRound == round.id and not board.settled then
		if name == "Participate" then
			board.participated = true
		elseif name == "Mark" and (round.phase == "Drawing" or round.phase == "LastCall") then
			Rules.mark(board, round.drawn, a, b)
		end
	end
	send(player, notice)
end)

Marketplace.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if passId~=Config.AutoMarkPass.Id or not purchased or not profiles[player] then return end
	task.spawn(function() Pass:check(player,true);send(player) end)
end)

task.spawn(function()
	while not closing do
		local ok,problem=pcall(function() Global:pump() end)
		if not ok then Global.running=false;warn("Global payout service: "..tostring(problem)) end
		broadcast()
		task.wait(5)
	end
end)

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(addPlayer, player) end

task.spawn(function()
	while not closing do
		task.wait(45)
		for player, profile in pairs(profiles) do
			if not profile.closing then
				task.spawn(function()
					Profiles.save(profile, false)
					if not profile.closing and not Profiles.writable(profile) then
						player:Kick("Your cloud save connection was interrupted. Please rejoin shortly.")
					else
						send(player)
					end
				end)
			end
		end
	end
end)

local function updateDisplay()
	local model = workspace:FindFirstChild("CloudpopWorkshop")
	if not model then return end
	local display, ball = model:FindFirstChild("DrawDisplay"), model:FindFirstChild("DrawnBall")
	local current = round.history[#round.history]
	local viewing = model:FindFirstChild("ViewingDisplay")
	if viewing then viewing.Readout.Text.Text = (if current then "BALL " .. current else "NEXT ROUND") .. "\n" .. #round.history .. " / " .. Config.DrawCount end
	if display then display.Readout.Text.Text = (if current then "BALL " .. current else "NEXT ROUND") .. "\n" .. #round.history .. " / " .. Config.DrawCount end
	if ball then ball.BallNumber.Text.Text = if current then tostring(current) else "—" end
end
local function phase(name, seconds, announcementKey)
	if announcementKey then
		local entry = assert(Manifest[announcementKey], "Missing announcement manifest entry")
		assert(entry.duration > 0 and entry.duration <= 3, "Voice clips must be at most 3 seconds for the draw cadence")
		round.announcementId += 1
		round.announcement = { id = round.announcementId, roundId = round.id, key = announcementKey,
			text = entry.text, duration = entry.duration, at = workspace:GetServerTimeNow() }
	end
	round.phase = name
	updateDisplay()
	round.deadline = workspace:GetServerTimeNow() + seconds
	broadcast()
	while not closing and workspace:GetServerTimeNow() < round.deadline do
		task.wait(math.min(0.15, round.deadline - workspace:GetServerTimeNow()))
	end
end

game:BindToClose(function()
	closing = true
	local remaining = 0
	for player, profile in pairs(profiles) do
		remaining += 1
		task.spawn(function()
			settle(player)
			Profiles.close(profile)
			remaining -= 1
		end)
	end
	local timeout = os.clock() + 25
	while (remaining > 0 or next(loading)) and os.clock() < timeout do task.wait(0.1) end
end)

while not closing do
	if next(profiles) == nil then
		round.phase = "Waiting"
		task.wait(1)
		continue
	end
	round.id += 1
	round.history, round.drawn = {}, {}
	boards, summaries = {}, {}
	for player in pairs(profiles) do
		if usable(player) then boards[player] = Rules.newCardState(Config, nextInteger) end
	end
	phase("Assignment", 0)
	phase("Intermission", Config.IntermissionSeconds, "upcoming")
	phase("Drawing", Manifest.start.duration, "start")
	local deck = Rules.shuffle(Config.NumberPool, nextInteger)
	for index = 1, Config.DrawCount do
		if closing then break end
		local number = deck[index]
		round.drawn[number] = true
		table.insert(round.history, number)
		for player, board in pairs(boards) do
			Rules.qualify(board, round.drawn)
			local profile=profiles[player]
			if profile and profile.data.settings.autoMark and Pass:owns(player) then Rules.markAll(board,round.drawn) end
		end
		phase("Drawing", Config.DrawSeconds, "number_" .. number)
	end
	if closing then break end
	phase("LastCall", 8, "lastCall")
	phase("Qualification", 0)
	-- Bonus execution is intentionally gated until distribution, timing and deduction rules are confirmed.
	for player in pairs(profiles) do settle(player) end
	phase("Results", Config.ResultsSeconds, "results")
	phase("Reset", 0)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">GlobalPayouts</string>
          <string name="Source"><![CDATA[local DataStoreService=game:GetService("DataStoreService")
local MessagingService=game:GetService("MessagingService")
local HttpService=game:GetService("HttpService")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Cloudpop")
local Rules=require(Shared.PayoutRules)
local Store=require(script.Parent.PayoutStore)
local Global={}
function Global.new(onRecord)
	local self={leader=nil,status="Loading global payout records",pending={},running=false,nextScan=0,candidates={},notifications={}}
	local enabled=not RunService:IsStudio()
	local store
	if not enabled then self.status="Studio test payouts are excluded" end
	local function publish(data) pcall(function() MessagingService:PublishAsync("CloudpopPayouts_v1",data) end) end
	function self:submit(record,ack)
		if not enabled or not Rules.valid(record,os.time()) then return end
		if not self.pending[record.id] then self.pending[record.id]={record=record,ack=ack,attemptAt=0,attempts=0} end
	end
	function self:view()
		local leader=self.leader
		if leader and not Rules.valid(leader,os.time()) then leader=nil;self.nextScan=0;self.status="Refreshing expired payout record" end
		return {leader=leader,status=self.status}
	end
	function self:pump()
		if not enabled or self.running then return end
		self.running=true
		if not store then
			local ok,result=pcall(Store.new,DataStoreService,Rules,os.time)
			if not ok then self.status="Payout record service unavailable; retrying";self.running=false;return end
			store=result
		end
		local now=os.time()
		local readCount=0
		for id,at in pairs(self.notifications) do
			if readCount>=4 then break end
			readCount+=1
			local record=store:read(id)
			if record and record.announcementToken then onRecord(record);self.notifications[id]=nil
			elseif now-at>30 then self.notifications[id]=nil end
		end
		local processed=0
		for id,entry in pairs(self.pending) do
			if processed>=4 then break end -- batch writes; no remote can flood this queue
			if entry.attemptAt>now then continue end
			processed+=1
			if now-entry.record.at>=86400 then self.pending[id]=nil; if entry.ack then entry.ack() end;continue end
			local ok=store:put(entry.record)
			if ok then
				self.pending[id]=nil
				self.candidates[id]=now
				self.nextScan=0
				if entry.ack then entry.ack() end
				publish({kind="changed",id=id})
			else
				entry.attempts+=1
				entry.attemptAt=now+math.min(120,5*2^math.min(entry.attempts,5))
				self.status="Payout record service delayed; retrying"
			end
		end
		if now>=self.nextScan then
			local leader,problem=store:leader()
			self.nextScan=now+60
			if problem then self.status="Payout record service delayed; retrying"
			else
				self.leader,self.status=leader,"Updated "..now
				if leader and self.candidates[leader.id] and now-leader.at<=120 then
					local token=HttpService:GenerateGUID(false)
					if store:claimAnnouncement(leader.id,token) then onRecord(leader);publish({kind="record",id=leader.id}) end
				end
			end
		end
		for id,at in pairs(self.candidates) do if now-at>120 then self.candidates[id]=nil end end
		self.running=false
	end
	if enabled then
		task.spawn(function()
			-- Subscription failure does not block gameplay; minute polling is the fallback.
			pcall(function()
				MessagingService:SubscribeAsync("CloudpopPayouts_v1",function(message)
					local data=message.Data
					if type(data)~="table" or type(data.id)~="string" or #data.id>80 then return end
					if data.kind=="changed" then
						self.candidates[data.id]=os.time()
						self.nextScan=math.min(self.nextScan,os.time()+10)
					elseif data.kind=="record" then
						self.notifications[data.id]=os.time()
					end
				end)
			end)
		end)
	end
	return self
end
return Global
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">LobbyPlan</string>
          <string name="Source"><![CDATA[-- Geometry in studs; shared by construction and collision/accessibility regression checks.
return {
	Height = 26,
	Rooms = {
		{ id = "DrawHall", name = "DRAW HALL", x1 = -48, x2 = 48, z1 = -40, z2 = 40 },
		{ id = "SocialLounge", name = "SOCIAL LOUNGE", x1 = 48, x2 = 106, z1 = -40, z2 = 0 },
		{ id = "ViewingRoom", name = "VIEWING ROOM", x1 = 48, x2 = 106, z1 = 0, z2 = 40 },
	},
	Doors = {
		{ axis = "z", fixed = 48, start = -40, finish = 40, centers = { -17, 17 }, width = 12, height = 12 },
		{ axis = "x", fixed = 0, start = 48, finish = 106, centers = { 77 }, width = 12, height = 12 },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PassService</string>
          <string name="Source"><![CDATA[-- Injected MarketplaceService makes ownership checks testable without simulated purchases.
local Pass = {}
function Pass.new(marketplace, config, clock)
	local self={states={}}
	local function configured() return type(config.Id)=="number" and config.Id%1==0 and config.Id>0 end
	function self:check(player, force)
		local state=self.states[player] or {owned=false,checkedAt=-math.huge,status="Checking ownership"}
		self.states[player]=state
		if not configured() then state.status="Pass ID not configured"; return state end
		if state.checking or (not force and clock()-state.checkedAt<15) then return state end
		state.checking=true
		local ok,owned=pcall(function() return marketplace:UserOwnsGamePassAsync(player.UserId,config.Id) end)
		state.checking,state.checkedAt=false,clock()
		if ok then state.owned=owned==true;state.status=if owned then "Owned" else "Not owned"
		else state.status="Ownership check unavailable; retry shortly" end
		return state
	end
	function self:view(player)
		local state=self.states[player]
		return {id=config.Id,intendedPrice=config.IntendedPrice,configured=configured(),owned=state and state.owned==true,status=state and state.status or "Checking ownership"}
	end
	function self:owns(player) return self.states[player] and self.states[player].owned==true end
	function self:forget(player) self.states[player]=nil end
	return self
end
return Pass
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">PayoutStore</string>
          <string name="Source"><![CDATA[-- Durable transaction metadata + two UTC-day ordered indexes. Never aggregates players.
-- Injected services keep query/tie/expiry/retry behavior testable.
local Store={}
function Store.new(dataStoreService, rules, clock)
	local records=dataStoreService:GetDataStore("CloudpopPayoutTransactions_v1")
	local self={}
	local function index(day) return dataStoreService:GetOrderedDataStore("CloudpopPayoutDay_v1_"..day) end
	local function key(record) return string.format("%010d:%s",record.at,record.id) end
	function self:put(record)
		if not rules.valid(record,clock()) then return false,"Ineligible payout" end
		local ok,result=pcall(function()
			local persisted=records:UpdateAsync(record.id,function(old)
				if old then return old end
				return table.clone(record)
			end)
			if not persisted or persisted.userId~=record.userId or persisted.at~=record.at or persisted.pesos~=record.pesos
				or persisted.multiplier~=record.multiplier or persisted.source~=record.source or persisted.playerName~=record.playerName then
				error("Conflicting payout transaction ID")
			end
			index(math.floor(record.at/86400)):SetAsync(key(record),record.pesos)
			return true
		end)
		return ok and result==true, if ok then nil else tostring(result)
	end
	function self:read(id)
		local ok,result=pcall(function() return records:GetAsync(id) end)
		return if ok and rules.valid(result,clock()) then result else nil
	end
	function self:leader(at)
		local now,best=at or clock(),nil
		local ok,problem=pcall(function()
			for day=math.floor((now-86400)/86400),math.floor(now/86400) do
				local pages=index(day):GetSortedAsync(false,100,1)
				local candidate,done=nil,false
				local pageCount=0
				repeat
					pageCount+=1
					assert(pageCount<=20,"Payout query page budget reached; retrying")
					for _,entry in ipairs(pages:GetCurrentPage()) do
						local timestamp,id=string.match(entry.key,"^(%d+):([%w_%-]+)$")
						local at=tonumber(timestamp)
						if candidate and entry.value<candidate.pesos then done=true;break end
						if at and at>now-86400 and at<=now then
							local contender={id=id,at=at,pesos=entry.value}
							if rules.better(contender,candidate) then candidate=contender end
						end
					end
					if pages.IsFinished or done then break end
					-- Query work runs in a background coroutine; throttling fails closed and retries later.
					pages:AdvanceToNextPageAsync()
				until false
				if candidate then
					local record=records:GetAsync(candidate.id)
					assert(rules.valid(record,now) and record.id==candidate.id and record.pesos==candidate.pesos and record.at==candidate.at,"Incomplete payout metadata")
					if rules.better(record,best) then best=record end
				end
			end
		end)
		return if ok then best else nil, if ok then nil else tostring(problem)
	end
	function self:claimAnnouncement(id, token)
		local now=clock()
		local candidate=self:read(id)
		if not candidate or now-candidate.at>120 then return false end
		-- A replacement caused by expiry is not a newly awarded record.
		local atAward,problem=self:leader(candidate.at)
		if problem or not atAward or atAward.id~=id then return false end
		local ok,result=pcall(function()
			return records:UpdateAsync(id,function(old)
				if not rules.valid(old,now) or now-old.at>120 then return nil end
				if old.announcementToken then return old end
				local updated=table.clone(old);updated.announcementToken=token
				return updated
			end)
		end)
		return ok and result~=nil and result.announcementToken==token
	end
	return self
end
return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PetService</string>
          <string name="Source"><![CDATA[local PetService={}
function PetService.new(builder, world)
	local folder=Instance.new("Folder")
	folder.Name,folder.Parent="CloudpopPets",world
	local models={}
	local self={}
	function self:sync(player, id)
		local current=models[player]
		if current and current.Name==id then return end
		if current then current:Destroy();models[player]=nil end
		if not id then return end
		local model=builder.build(id)
		model:SetAttribute("OwnerUserId",player.UserId)
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		model:PivotTo(if root then root.CFrame*CFrame.new(3,1,3) else CFrame.new(0,-30,0))
		model.Parent=folder
		models[player]=model
	end
	function self:remove(player) self:sync(player,nil) end
	return self
end
return PetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Cloudpop")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local Store = {}
local database
local LEASE_SECONDS = 300

local function getDatabase()
	-- GetDataStore can itself fail in an unpublished place. Practice never calls it.
	if not database then database = DataStoreService:GetDataStore(Config.DataStoreName) end
	return database
end

local function retry(operation)
	for attempt = 1, 3 do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		warn("Cloudpop data request failed (attempt " .. attempt .. "). " .. tostring(result))
		if attempt < 3 then
			task.wait(attempt * 2)
		end
	end
	return false, nil
end

function Store.load(player)
	-- Studio is deliberately session-only unless explicitly opted in on this module.
	-- Use a separate published TEST experience when enabling Studio saves.
	if RunService:IsStudio() and script:GetAttribute("EnableStudioSaves") ~= true then
		return { data = Economy.defaults(), practice = true, saveStatus = "Studio practice · not saved", closing = false }
	end
	local token = HttpService:GenerateGUID(false)
	local key = "player_" .. player.UserId
	local denial = "Profile is open on another server. Please retry shortly."
	local ok, record = retry(function()
		return getDatabase():UpdateAsync(key, function(old)
			if old ~= nil then
				if type(old) ~= "table" or type(old.data) ~= "table" or old.data.version ~= 1 then
					denial = "Your save needs a compatible game version. Please retry later."
					return nil
				end
				if type(old.lock) == "table" and old.lock.id ~= token
					and type(old.lock.expires) == "number" and old.lock.expires > os.time() then
					return nil
				end
			end
			return {
				data = Economy.normalize(if old then old.data else nil, Config.Catalog),
				lock = { id = token, expires = os.time() + LEASE_SECONDS },
			}
		end)
	end)
	if not ok then
		return nil, "Cloud saves are unavailable. Please retry; your existing save has not been replaced."
	end
	if not record or not record.lock or record.lock.id ~= token then
		return nil, denial
	end
	return { data = record.data, key = key, token = token, expires = record.lock.expires,
		practice = false, saving = false, closing = false, saveStatus = "Cloud save connected" }
end

function Store.writable(profile)
	return profile and not profile.closing and (profile.practice or os.time() < profile.expires - 30)
end

function Store.save(profile, release)
	if profile.practice then
		return true
	end
	while profile.saving do
		task.wait(0.1)
	end
	profile.saving = true
	local snapshot = Economy.normalize(profile.data, Config.Catalog)
	local snapshotRevision = profile.revision or 0
	local ok, result = retry(function()
		return getDatabase():UpdateAsync(profile.key, function(old)
			-- Never overwrite another server's session or resurrect a released lock.
			if type(old) ~= "table" or type(old.lock) ~= "table" or old.lock.id ~= profile.token then
				return nil
			end
			return { data = snapshot, lock = if release then nil else {
				id = profile.token, expires = os.time() + LEASE_SECONDS,
			} }
		end)
	end)
	profile.saving = false
	if ok and result then
		if not release then
			profile.expires = result.lock.expires
		end
		profile.saveStatus = if (profile.revision or 0) == snapshotRevision then "Progress saved" else "Changes waiting to save"
		if Store.onSaved then
			local notified,problem=pcall(Store.onSaved,profile,snapshot)
			if not notified then warn("Payout indexing deferred: "..tostring(problem)) end
		end
		return true
	end
	profile.saveStatus = "Save delayed · retrying"
	return false
end

function Store.close(profile)
	if profile.closing then
		while not profile.closed do task.wait(0.1) end
		return
	end
	profile.closing = true
	if not Store.save(profile, true) then
		warn("Cloudpop could not finish a profile save; its session lock will expire automatically.")
	end
	profile.closed = true
end

return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ResultFeed</string>
          <string name="Source"><![CDATA[-- Only trusted award/bonus-completion code may call these methods. No client result remote exists.
local Feed={}
function Feed.new(clock)
	local self={recent={},messages={},seen={},seenOrder={},serial=0}
	function self:message(text,id)
		if self.seen[id] then return end
		self.seen[id]=true
		table.insert(self.seenOrder,id)
		if #self.seenOrder>256 then self.seen[table.remove(self.seenOrder,1)]=nil end
		self.serial+=1
		table.insert(self.messages,{id=id,serial=self.serial,text=text,at=clock()})
		while #self.messages>12 do table.remove(self.messages,1) end
	end
	function self:completeBonus(event)
		if self.seen["bonus:"..event.id] then return false end
		assert(type(event.results)=="table" and #event.results>0,"No confirmed results")
		-- Call only AFTER every listed result has actually been credited/debited.
		local recipients={}
		for _,result in ipairs(event.results) do
			assert(result.committed==true and type(result.pesos)=="number" and result.pesos==result.pesos and math.abs(result.pesos)<math.huge,"Uncommitted result")
			table.insert(recipients,result.playerName..": "..result.multiplier.."×, "..(if result.pesos>0 then "+" else "")..result.pesos.." Pesos")
		end
		table.insert(self.recent,1,{id=event.id,name=event.name,at=event.at,results=event.results})
		while #self.recent>4 do table.remove(self.recent) end
		local text=event.name.." completed — "..table.concat(recipients,"; ")
		if #text>400 then text=event.name.." completed for "..#recipients.." players. Full signed results in Records." end
		self:message(text,"bonus:"..event.id)
		return true
	end
	function self:record(record)
		self:message("Highest payout — last 24 hours: "..record.playerName.." received "..record.pesos.." Pesos from "..record.source.." ("..record.multiplier.."×).","record:"..record.id)
	end
	return self
end
return Feed
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Workshop</string>
          <string name="Source"><![CDATA[-- Original enclosed observatory, built only from Roblox primitives.
local Plan = require(script.Parent.LobbyPlan)
local Workshop = {}
function Workshop.build()
	if workspace:FindFirstChild("CloudpopWorkshop") then return end
	local model = Instance.new("Model")
	model.Name, model.Parent = "CloudpopWorkshop", workspace
	local navy, blue, ice, cyan = Color3.fromRGB(16, 30, 58), Color3.fromRGB(37, 76, 121), Color3.fromRGB(211, 232, 248), Color3.fromRGB(91, 214, 232)
	local function part(name, size, position, color, material, class, parent)
		local item = Instance.new(class or "Part")
		item.Name, item.Size, item.Position = name, size, position
		item.Anchored, item.Color = true, color
		item.Material = material or Enum.Material.SmoothPlastic
		item.TopSurface, item.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		item.Parent = parent or model
		return item
	end
	local function sign(parent, name, text, size, face)
		local surface = Instance.new("SurfaceGui")
		surface.Name, surface.Face, surface.CanvasSize = name, face or Enum.NormalId.Back, Vector2.new(1000, 350)
		surface.Parent = parent
		local label = Instance.new("TextLabel")
		label.Name, label.Size = "Text", UDim2.fromScale(1, 1)
		label.BackgroundTransparency, label.TextColor3 = 1, ice
		label.Font, label.TextSize, label.TextWrapped = Enum.Font.GothamBold, size or 64, true
		label.Text, label.Parent = text, surface
		return label
	end
	part("Foundation", Vector3.new(158, 5, 84), Vector3.new(29, -3, 0), navy, Enum.Material.Slate)
	for _,x in ipairs({-40,98}) do
		for _,z in ipairs({-30,30}) do
			part("MarineSupport",Vector3.new(4,10,4),Vector3.new(x,-9.5,z),navy,Enum.Material.Metal)
		end
	end
	for _, room in ipairs(Plan.Rooms) do
		local center = Vector3.new((room.x1 + room.x2) / 2, 0, (room.z1 + room.z2) / 2)
		part(room.id .. "Floor", Vector3.new(room.x2-room.x1, 1, room.z2-room.z1), center, blue, Enum.Material.Marble)
		part(room.id .. "Ceiling", Vector3.new(room.x2-room.x1, 1, room.z2-room.z1), Vector3.new(center.X, Plan.Height, center.Z), navy)
		for _, offset in ipairs({ -8, 8 }) do
			local lamp = part("CeilingLight", Vector3.new(14, 0.2, 1.2), Vector3.new(center.X, Plan.Height - 0.6, center.Z + offset), ice, Enum.Material.Neon)
			local light = Instance.new("SurfaceLight")
			light.Face, light.Brightness, light.Range, light.Angle, light.Shadows = Enum.NormalId.Bottom, 1.2, 35, 130, false
			light.Color, light.Parent = ice, lamp
		end
	end
	local function wallPiece(name, axis, fixed, low, high, y, height, color, material)
		if high <= low then return nil end
		local size = if axis == "x" then Vector3.new(high-low, height, 1) else Vector3.new(1, height, high-low)
		local position = if axis == "x" then Vector3.new((low+high)/2, y, fixed) else Vector3.new(fixed, y, (low+high)/2)
		return part(name, size, position, color, material)
	end
	-- All exterior walls are closed: opaque sill/lintel + collidable glazing between.
	for _, wall in ipairs({ {"x",-40,-48,106}, {"x",40,-48,106}, {"z",-48,-40,40}, {"z",106,-40,40} }) do
		local axis, fixed, low, high = table.unpack(wall)
		wallPiece("ExteriorSill", axis, fixed, low, high, 2.5, 5, navy)
		wallPiece("ExteriorLintel", axis, fixed, low, high, 23.5, 5, navy)
		local glass = wallPiece("Window", axis, fixed, low, high, 13, 16, ice, Enum.Material.Glass)
		glass.Transparency = 0.68
		wallPiece("WindowTrim", axis, fixed, low, high, 5, 0.25, cyan, Enum.Material.Metal)
		wallPiece("Cornice", axis, fixed, low, high, 25.2, 0.5, blue, Enum.Material.Metal)
		for at = low, high, 12 do wallPiece("WindowMullion", axis, fixed, at, math.min(at+0.5, high), 13, 16, blue, Enum.Material.Metal) end
	end
	for _, wall in ipairs(Plan.Doors) do
		local cursor = wall.start
		for _, center in ipairs(wall.centers) do
			local left, right = center-wall.width/2, center+wall.width/2
			wallPiece("InteriorWall", wall.axis, wall.fixed, cursor, left, Plan.Height/2, Plan.Height, navy)
			wallPiece("DoorLintel", wall.axis, wall.fixed, left, right, (Plan.Height+wall.height)/2, Plan.Height-wall.height, navy)
			for _, edge in ipairs({left, right}) do wallPiece("DoorTrim", wall.axis, wall.fixed, edge-0.2, edge+0.2, wall.height/2, wall.height, cyan, Enum.Material.Metal) end
			cursor = right
		end
		wallPiece("InteriorWall", wall.axis, wall.fixed, cursor, wall.finish, Plan.Height/2, Plan.Height, navy)
	end
	for _,entry in ipairs({{-17,"SOCIAL LOUNGE · SKY CAFÉ"},{17,"VIEWING ROOM"}}) do
		local plaque=part("Wayfinding",Vector3.new(0.3,2.4,14),Vector3.new(47.35,14.5,entry[1]),blue)
		sign(plaque,"Directions",entry[2],48,Enum.NormalId.Left)
	end
	part("CentralWalkway", Vector3.new(16, 0.06, 66), Vector3.new(0, 0.54, 0), ice)
	for _, x in ipairs({ -8.1, 8.1 }) do part("PathLight", Vector3.new(0.16, 0.08, 66), Vector3.new(x, 0.56, 0), cyan, Enum.Material.Neon) end
	part("PresenterStage", Vector3.new(36, 0.6, 20), Vector3.new(0, 0.8, -25), navy)
	part("StageStep", Vector3.new(36, 0.3, 2), Vector3.new(0, 0.65, -14), blue)
	local machine = part("MachinePedestal", Vector3.new(14, 3, 10), Vector3.new(0, 2.6, -24), navy, Enum.Material.Metal)
	sign(machine, "Nameplate", "CLOUDPOP  /  COMMONS", 52)
	part("MachineTrim", Vector3.new(14.2, 0.25, 10.2), Vector3.new(0, 4.2, -24), cyan, Enum.Material.Neon)
	local globe = part("AirChamber", Vector3.new(10, 10, 10), Vector3.new(0, 9, -24), ice, Enum.Material.Glass)
	globe.Shape, globe.Transparency, globe.CanCollide = Enum.PartType.Ball, 0.72, false
	for index = 1, 16 do
		local angle = index * math.pi / 8
		local ball = part("DecorativeBall" .. index, Vector3.new(1.1, 1.1, 1.1), Vector3.new(math.cos(angle)*3, 7+index%4, -24+math.sin(angle)*3), if index%3==0 then ice else cyan)
		ball.Shape, ball.CanCollide, ball.CastShadow = Enum.PartType.Ball, false, false
	end
	local display = part("DrawDisplay", Vector3.new(26, 6, 0.5), Vector3.new(0, 19, -36), navy)
	sign(display, "Readout", "WELCOME\n0 / 20", 90)
	local emerged = part("DrawnBall", Vector3.new(2.6, 2.6, 2.6), Vector3.new(0, 6, -17), ice)
	emerged.Shape, emerged.CanCollide = Enum.PartType.Ball, false
	local tag = Instance.new("BillboardGui")
	tag.Name, tag.Size, tag.AlwaysOnTop, tag.MaxDistance = "BallNumber", UDim2.fromOffset(64,64), false, 100
	tag.Parent = emerged
	local text = Instance.new("TextLabel")
	text.Name, text.Size, text.BackgroundTransparency = "Text", UDim2.fromScale(1,1), 1
	text.Font, text.TextSize, text.TextColor3, text.Text, text.Parent = Enum.Font.GothamBold, 36, navy, "—", tag
	-- Original stage character; geometric face/uniform, no downloaded avatar or voice.
	local presenter = Instance.new("Model")
	presenter.Name, presenter.Parent = "Presenter", model
	local skin = Color3.fromRGB(181, 126, 93)
	local torso = part("Torso", Vector3.new(2,2,1), Vector3.new(12,4.1,-25), blue, nil, nil, presenter)
	part("Head", Vector3.new(1.7,1.6,1.5), Vector3.new(12,5.9,-25), skin, nil, nil, presenter)
	for _, side in ipairs({-1,1}) do
		part(if side<0 then "Left Arm" else "Right Arm", Vector3.new(0.8,2,0.9), Vector3.new(12+side*1.45,4.1,-25), blue, nil, nil, presenter)
		part(if side<0 then "Left Leg" else "Right Leg", Vector3.new(0.8,2,0.9), Vector3.new(12+side*0.5,2.1,-25), navy, nil, nil, presenter)
		part("Eye", Vector3.new(0.15,0.18,0.08), Vector3.new(12+side*0.35,6.05,-24.22), navy, nil, nil, presenter).CanCollide = false
	end
	part("Smile", Vector3.new(0.45,0.1,0.08), Vector3.new(12,5.55,-24.22), ice, nil, nil, presenter).CanCollide=false
	part("Hair", Vector3.new(1.85,0.5,1.65), Vector3.new(12,6.75,-25), navy, nil, nil, presenter)
	part("Lapel", Vector3.new(0.2,1.3,0.1), Vector3.new(12,4.15,-24.45), cyan, nil, nil, presenter)
	presenter.PrimaryPart = torso
	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath = false, false
	humanoid.DisplayName, humanoid.DisplayDistanceType, humanoid.Parent = "Lumi", Enum.HumanoidDisplayDistanceType.None, presenter
	part("MicrophoneStand", Vector3.new(0.2,4.5,0.2), Vector3.new(11,3.35,-23), navy, Enum.Material.Metal)
	local microphone = part("Microphone", Vector3.new(0.6,0.35,0.8), Vector3.new(11,5.7,-23), ice, Enum.Material.Metal)
	microphone.CanCollide=false
	local function seat(x,z,rotation)
		local item = part("LoungeSeat", Vector3.new(3.4,0.8,3.4), Vector3.new(x,2,z), blue, Enum.Material.Fabric,"Seat")
		item.Orientation = Vector3.new(0,rotation,0)
		local offset = if rotation == 180 then -1.6 else 1.6
		part("SeatBack",Vector3.new(3.4,2.4,0.6),Vector3.new(x,3.1,z+offset),navy,Enum.Material.Fabric)
		part("SeatFoot",Vector3.new(2,1,2),Vector3.new(x,1,z),navy,Enum.Material.Metal)
	end
	local function tableAt(x,z)
		part("TableBase",Vector3.new(2,3,2),Vector3.new(x,2,z),navy,Enum.Material.Metal)
		part("TableTop",Vector3.new(10,0.45,7),Vector3.new(x,3.7,z),ice)
		seat(x,z-5.2,180); seat(x,z+5.2,0)
	end
	for _, x in ipairs({-28,28}) do for _, z in ipairs({-5,20}) do tableAt(x,z) end end
	-- Social room: conversation seating to the left; non-alcoholic café on its north wall.
	part("LoungeRug",Vector3.new(25,0.06,19),Vector3.new(70,0.55,-22),navy,Enum.Material.Fabric)
	for _, x in ipairs({62,67,72}) do seat(x,-29,180); seat(x,-14,0) end
	part("CoffeeTable",Vector3.new(12,1.5,5),Vector3.new(67,1.3,-21),ice)
	part("CafeCounter",Vector3.new(19,4,4),Vector3.new(92,2.5,-29),navy)
	part("CafeCounterTop",Vector3.new(20,0.3,4.5),Vector3.new(92,4.65,-29),ice,Enum.Material.Marble)
	part("CafeBackCabinet",Vector3.new(19,3,3),Vector3.new(92,2,-36),blue)
	part("CafeShelf",Vector3.new(19,0.4,3),Vector3.new(92,7,-36),ice)
	local menu = part("CafeMenu",Vector3.new(19,4,0.25),Vector3.new(92,11,-38),navy)
	sign(menu,"Menu","SKY CAFÉ\nTea · Cocoa · Fruit coolers",58)
	for _, x in ipairs({86,92,98}) do
		seat(x,-23,0)
		part("CafeCup",Vector3.new(0.6,0.8,0.6),Vector3.new(x,5.2,-29),cyan)
	end
	part("CoffeeMachine",Vector3.new(3,3,2),Vector3.new(99,5,-36),navy,Enum.Material.Metal)
	-- Separate viewing room, furnished and linked through its own hall door.
	local screen = part("ViewingDisplay",Vector3.new(25,8,0.5),Vector3.new(79,12,3),navy)
	sign(screen,"Readout","CLOUDPOP LIVE\n0 / 20",78)
	for _, z in ipairs({15,25}) do for _, x in ipairs({66,73,80,87}) do seat(x,z,0) end end
	part("MediaConsole",Vector3.new(25,2,3),Vector3.new(79,1.5,4),blue)
	for _, x in ipairs({60,99}) do
		part("DisplayPlinth",Vector3.new(3,4,3),Vector3.new(x,2.5,33),navy)
		local sculpture=part("OrbitSculpture",Vector3.new(2,2,2),Vector3.new(x,5.5,33),cyan,Enum.Material.Glass)
		sculpture.Shape=Enum.PartType.Ball
	end
	for _, location in ipairs({{-39,-29},{-39,29},{40,30},{56,-35},{99,-7},{99,32}}) do
		local x,z=location[1],location[2]
		part("Planter",Vector3.new(3,2,3),Vector3.new(x,1.5,z),navy)
		for i=1,3 do
			local leaf=part("CrystalFern",Vector3.new(0.5,3+i,1.5),Vector3.new(x+i-2,4,z),cyan)
			leaf.Orientation,leaf.CanCollide=Vector3.new(0,i*50,(i-2)*22),false
		end
	end
	-- Real scenery beyond the glazed envelope, with no exposed starter baseplate.
	part("ExteriorSea",Vector3.new(1100,2,1100),Vector3.new(20,-13,0),blue,Enum.Material.Glass)
	for _, location in ipairs({{-150,-110},{155,-110},{210,90},{-170,100}}) do
		local rock=part("DistantIsland",Vector3.new(65,32,55),Vector3.new(location[1],-5,location[2]),navy,Enum.Material.Slate)
		rock.Shape=Enum.PartType.Ball
		for index=1,3 do
			local cloud=part("DistantCloud",Vector3.new(25,10,16),Vector3.new(location[1]+index*12,37,location[2]),ice)
			cloud.Shape,cloud.CanCollide=Enum.PartType.Ball,false
		end
	end
	local spawn=part("WelcomeMat",Vector3.new(10,0.1,6),Vector3.new(0,0.65,31),blue,nil,"SpawnLocation")
	spawn.Neutral,spawn.Duration,spawn.Transparency=true,0,1
	local lighting=game:GetService("Lighting")
	lighting.ClockTime,lighting.Brightness=14,2
	lighting.Ambient,lighting.OutdoorAmbient=Color3.fromRGB(110,136,169),Color3.fromRGB(152,175,203)
	-- FallenPartsDestroyHeight stays in the place file, never in runtime code.
end
return Workshop
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="25">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="26">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="27">
      <Properties>
        <string name="Name">CloudpopUI</string>
        <int name="DisplayOrder">10</int>
        <bool name="ResetOnSpawn">false</bool>
      </Properties>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">AudioController</string>
          <string name="Source"><![CDATA[-- One looping music voice, one queued human-voice channel, four effect voices.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local Audio = {}
function Audio.new(config, manifest)
	local music = Instance.new("Sound")
	music.Name, music.Looped, music.Volume, music.Parent = "CloudpopMusic", true, 0, SoundService
	local voice = Instance.new("Sound")
	voice.Name, voice.Volume, voice.Parent = "CloudpopVoice", 0.8, SoundService
	local effects = {}
	for index = 1, 4 do
		local sound = Instance.new("Sound")
		sound.Name, sound.Parent = "CloudpopEffect" .. index, SoundService
		effects[index] = sound
	end
	local self = { musicVolume = 0.5, voiceVolume = 0.8, sfxVolume = 0.7, track = nil, generation = 0, nextEffect = 0 }
	local fade, switching, speaking = nil, false, false
	local queue, lastId, current, subtitle = {}, 0, nil, ""
	local function asset(value)
		return if type(value) == "string" and string.match(value, "^rbxassetid://%d+$") then value else ""
	end
	local preloaded, ids, known = {}, {}, {}
	local function collect(id)
		id = asset(id)
		if id ~= "" and not known[id] then known[id] = true; table.insert(ids,id) end
	end
	for _, id in pairs(config.Music) do collect(id) end
	for _, id in pairs(config.SFX) do collect(id) end
	for _, entry in pairs(manifest or {}) do collect(entry.assetId) end
	if #ids > 0 then
		task.spawn(function()
			local ok = pcall(function()
				ContentProvider:PreloadAsync(ids,function(id,status)
					if status == Enum.AssetFetchStatus.Success then preloaded[id] = true end
				end)
			end)
			if not ok then warn("Cloudpop audio preload failed; unloaded voice cues use subtitles.") end
		end)
	end
	local function transition(volume)
		if fade then fade:Cancel() end
		fade = TweenService:Create(music, TweenInfo.new(0.25), { Volume = volume })
		fade:Play()
	end
	local function targetVolume()
		return if switching then 0 else self.musicVolume * (if speaking and self.voiceVolume > 0 then 0.22 else 1)
	end
	local function stopVoice()
		voice:Stop()
		speaking = false
		transition(targetVolume())
	end
	voice.Ended:Connect(function()
		speaking = false
		transition(targetVolume())
	end)
	function self:setVolumes(settings)
		local musicValue, voiceValue = settings.musicVolume or 0.5, settings.voiceVolume or 0.8
		local changed = self.musicVolume ~= musicValue or self.voiceVolume ~= voiceValue
		self.musicVolume, self.voiceVolume, self.sfxVolume = musicValue, voiceValue, settings.sfxVolume or 0.7
		voice.Volume = voiceValue
		if changed then transition(targetVolume()) end
	end
	function self:setTrack(key)
		-- With an unfilled bonus slot, a supplied lobby track continues rather than cutting to silence.
		if asset(config.Music[key]) == "" then key = "lobby" end
		if self.track == key then return end
		self.track, self.generation, switching = key, self.generation + 1, true
		local generation = self.generation
		transition(0)
		task.delay(0.26, function()
			if generation ~= self.generation then return end
			music:Stop()
			music.SoundId, switching = asset(config.Music[key]), false
			if music.SoundId == "" then return end -- Missing licensed track: do not invent one.
			music.Volume = 0
			music:Play()
			transition(targetVolume())
		end)
	end
	function self:play(key)
		local id = asset(config.SFX[key])
		if id == "" or self.sfxVolume == 0 then return end
		self.nextEffect = self.nextEffect % #effects + 1
		local sound = effects[self.nextEffect]
		sound:Stop()
		sound.SoundId, sound.Volume = id, self.sfxVolume
		sound:Play()
	end
	function self:announce(event, now)
		if not event or event.id <= lastId then return end
		lastId = event.id
		if now >= event.at + event.duration then return end -- Late joins do not replay old draws.
		if #queue < 8 then table.insert(queue, event) end
		self:update(now)
	end
	function self:update(now)
		if current and now >= current.at + current.duration then
			stopVoice()
			current, subtitle = nil, ""
		end
		while not current and #queue > 0 do
			local event = queue[1]
			if event.at > now then break end
			table.remove(queue, 1)
			if now >= event.at + event.duration then continue end
			current, subtitle = event, event.text
			local entry = manifest and manifest[event.key]
			local id = entry and asset(entry.assetId) or ""
			-- Start a fresh recording only near its reveal. Late arrivals get the correct subtitle.
			if id ~= "" and preloaded[id] and self.voiceVolume > 0 and now - event.at <= 0.5 then
				voice.SoundId, voice.TimePosition, voice.Volume = id, 0, self.voiceVolume
				speaking = true
				voice:Play()
				transition(targetVolume())
			end
		end
		return subtitle
	end
	return self
end
return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">CardPanel</string>
          <string name="Source"><![CDATA[-- Horizontal main cards and an adjacent 2x2 bonus group, in one bottom-center tray.
local Panel = {}
function Panel.new(gui, ui, config, layout, request)
	local frame, label, button, make = ui.frame, ui.label, ui.button, ui.make
	local colors = ui.colors
	local tray = frame("CardPanel", gui, UDim2.fromOffset(930,334), UDim2.new(0.5,0,1,-78))
	tray.AnchorPoint = Vector2.new(0.5,1)
	local scroll = make("ScrollingFrame","CardScroll",tray,{Position=UDim2.fromOffset(10,50),Size=UDim2.new(1,-20,1,-60),
		BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,ScrollingDirection=Enum.ScrollingDirection.XY,
		CanvasSize=UDim2.fromOffset(930,276)})
	local cards, bonusRows, geometry = {}, {}, nil
	local heading=label("Title",tray,"YOUR CARDS",UDim2.fromOffset(110,44),UDim2.fromOffset(10,0),14)
	button("MainNavigation",tray,"Main",UDim2.fromOffset(64,40),UDim2.fromOffset(122,3),function() scroll.CanvasPosition=Vector2.new(0,0) end)
	button("BonusNavigation",tray,"Bonus →",UDim2.fromOffset(86,40),UDim2.fromOffset(192,3),function()
		if geometry then scroll.CanvasPosition=Vector2.new(geometry.bonusX,0) end
	end)
	local function createCard(index)
		local card=frame("MainCard"..index,scroll,UDim2.fromOffset(layout.CardWidth,layout.CardHeight),UDim2.fromOffset((index-1)*(layout.CardWidth+layout.Gap),0))
		local title=label("Multiplier",card,"Card "..index.." · awaiting deal",UDim2.new(1,-16,0,28),UDim2.fromOffset(8,2),15)
		local cells={}
		for cellIndex=1,25 do
			cells[cellIndex]=button("Cell"..cellIndex,card,"—",UDim2.fromOffset(44,44),
				UDim2.fromOffset(8+(cellIndex-1)%5*46,32+math.floor((cellIndex-1)/5)*46),function() request("Mark",index,cellIndex) end)
		end
		local rewardNote=label("RewardNote",card,"Pattern rewards pending",UDim2.new(1,-16,0,14),UDim2.fromOffset(8,261),11)
		rewardNote.TextColor3=colors.navy
		return {frame=card,title=title,cells=cells}
	end
	for index=1,config.Main.Count do cards[index]=createCard(index) end
	local group=frame("BonusGroup",scroll,UDim2.fromOffset(layout.BonusWidth,layout.CardHeight),UDim2.fromOffset(config.Main.Count*(layout.CardWidth+layout.Gap),0))
	group.BackgroundTransparency=1
	for index,definition in ipairs(config.Bonuses) do
		local row=frame(definition.id,group,UDim2.fromOffset(192,132),UDim2.fromOffset((index-1)%2*204,math.floor((index-1)/2)*144))
		local title=label("Title",row,definition.name,UDim2.new(1,-16,0,26),UDim2.fromOffset(8,4),16)
		local numbers=label("Numbers",row,"Waiting for cards",UDim2.new(1,-16,0,52),UDim2.fromOffset(8,32),20)
		local progress=label("Progress",row,"",UDim2.new(1,-16,0,38),UDim2.fromOffset(8,89),13)
		bonusRows[definition.id]={title=title,numbers=numbers,progress=progress}
	end
	local self={root=tray}
	function self:resize(width,height,touch)
		geometry=layout.compute(width,height,touch,config.Main.Count)
		tray.Size,tray.Position=UDim2.fromOffset(geometry.width,geometry.height),UDim2.new(0.5,0,1,-geometry.footer)
		scroll.CanvasSize=UDim2.fromOffset(geometry.contentWidth,layout.CardHeight)
		group.Position=UDim2.fromOffset(geometry.bonusX,0)
		return geometry
	end
	function self:setStatus(text) heading.Text=text end
	function self:render(snapshot,cardColor,markerColor)
		heading.Text="Ball "..tostring(snapshot.history[#snapshot.history] or "—").." · "..#snapshot.history.."/20"
		for index,view in ipairs(cards) do
			local data=snapshot.cards[index]
			view.title.Text=if data then "Card "..index.."  ·  "..data.multiplier.."×" else "Card "..index.." · next round"
			view.frame.BackgroundColor3=cardColor
			view.title.TextColor3=colors.navy
			for cellIndex,cell in ipairs(view.cells) do
				local entry=data and data.cells[cellIndex]
				local prefix=if entry and entry.marked then "✓" elseif entry and entry.available then "•" else ""
				cell.Text=if entry then (if entry.number==0 then "FREE" else prefix..entry.number) else "—"
				cell.TextSize=18
				cell.BackgroundColor3=if entry and entry.marked then markerColor elseif entry and entry.available then colors.cyan else colors.blue
				cell.TextColor3=if entry and (entry.marked or entry.available) then colors.navy else colors.ice
				cell.Active=entry~=nil and entry.available and not entry.marked
			end
		end
		for _,bonus in ipairs(snapshot.bonuses) do
			local row,numbers=bonusRows[bonus.id],{}
			for _,entry in ipairs(bonus.cells) do table.insert(numbers,(if entry.marked then "✓" else "")..entry.number) end
			row.numbers.Text=if #numbers>0 then table.concat(numbers,"  ") else "Awaiting numbers"
			row.progress.Text=if bonus.qualified then "✓ QUALIFIED\nResolution pending" elseif bonus.target==0 then "Qualification count pending" elseif #bonus.cells==0 then "Joining next round" else bonus.progress.." / "..bonus.target.." matched"
			row.title.TextColor3=if bonus.qualified then colors.cyan else colors.ice
		end
	end
	return self
end
return Panel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">FeaturePanels</string>
          <string name="Source"><![CDATA[local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local TextChatService=game:GetService("TextChatService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Cloudpop")
local PetBuilder=require(Shared.PetBuilder)
local Features={}
function Features.new(body,settings,ui,config,request)
	local self={pages={},heights={Pets=580,Chest=270,Records=820},state=nil,seenSerial=0,queue={},nextMessage=0,price=nil,priceId=nil}
	local make,label,button=ui.make,ui.label,ui.button
	local function page(name,height)
		local frame=make("Frame",name,body,{Size=UDim2.new(1,-6,0,height),BackgroundTransparency=1,Visible=false})
		self.pages[name]=frame;return frame
	end
	local pets=page("Pets",580)
	local petButtons={}
	local petIndex=0
	for _,item in ipairs(config.Catalog) do
		if item.category~="pet" then continue end
		local y=petIndex*172;petIndex+=1
		local preview=make("ViewportFrame",item.id.."Preview",pets,{Size=UDim2.fromOffset(98,106),Position=UDim2.fromOffset(0,y),BackgroundTransparency=1,
			Ambient=Color3.fromRGB(220,230,255),LightColor=Color3.fromRGB(255,250,230)})
		local world=make("WorldModel","PreviewWorld",preview)
		local model=PetBuilder.build(item.id);model.Parent=world
		local camera=make("Camera","PreviewCamera",preview,{CFrame=CFrame.lookAt(Vector3.new(3,1.8,-5),Vector3.new(0,0,0)),FieldOfView=36})
		preview.CurrentCamera=camera
		label(item.id.."Name",pets,item.name,UDim2.new(1,-104,0,30),UDim2.fromOffset(104,y),16)
		label(item.id.."Description",pets,item.description or "Cosmetic companion",UDim2.new(1,-104,0,74),UDim2.fromOffset(104,y+30),13)
		petButtons[item.id]=button(item.id,pets,item.price.." Pesos",UDim2.new(1,0,0,48),UDim2.fromOffset(0,y+112),function() request("Cosmetic",item.id) end)
	end
	button("UnequipPet",pets,"Unequip pet",UDim2.new(1,0,0,44),UDim2.fromOffset(0,524),function() request("UnequipPet") end)
	local chest=page("Chest",270)
	label("ChestTitle",chest,"FREE DAILY CHEST",UDim2.new(1,0,0,32),UDim2.fromOffset(0,0),17)
	label("ChestDetails",chest,"Permanent upgrade · no paid keys or resets. Missing a day never removes earned progress. Probability effect awaits confirmed rules.",UDim2.new(1,0,0,102),UDim2.fromOffset(0,36),14)
	local chestStatus=label("ChestStatus",chest,"",UDim2.new(1,0,0,76),UDim2.fromOffset(0,140),13)
	local claim=button("ClaimChest",chest,"Rules pending",UDim2.new(1,0,0,44),UDim2.fromOffset(0,220),function()
		if self.state and self.state.chest and self.state.chest.canClaim then request("ClaimChest") end
	end)
	local records=page("Records",820)
	label("TopPayoutTitle",records,"Highest payout — last 24 hours",UDim2.new(1,0,0,48),UDim2.fromOffset(0,0),17)
	local top=label("TopPayout",records,"Loading global payout records",UDim2.new(1,0,0,142),UDim2.fromOffset(0,50),14)
	label("RecentTitle",records,"Recent bonuses · this server",UDim2.new(1,0,0,42),UDim2.fromOffset(0,198),17)
	local recent=label("RecentBonuses",records,"No completed bonus events yet.",UDim2.new(1,0,0,570),UDim2.fromOffset(0,246),13)
	recent.TextYAlignment=Enum.TextYAlignment.Top
	recent.AutomaticSize=Enum.AutomaticSize.Y
	self.recordsText=recent
	label("PassTitle",settings,"PERMANENT AUTO MARK",UDim2.new(1,0,0,32),UDim2.fromOffset(0,410),16)
	local passStatus=label("PassStatus",settings,"Pass ID not configured",UDim2.new(1,0,0,86),UDim2.fromOffset(0,446),13)
	local buy=button("BuyAutoMark",settings,"Unavailable",UDim2.new(1,0,0,44),UDim2.fromOffset(0,540),function()
		local pass=self.state and self.state.pass
		if pass and pass.configured and not pass.owned and self.price and self.priceId==pass.id then
			pcall(function() Marketplace:PromptGamePassPurchase(Players.LocalPlayer,pass.id) end)
		end
	end)
	local toggle=button("ToggleAutoMark",settings,"Auto Mark · Off",UDim2.new(1,0,0,44),UDim2.fromOffset(0,590),function()
		if self.state and self.state.pass and self.state.pass.owned then request("Setting","autoMark",not self.state.settings.autoMark) end
	end)
	button("RefreshPass",settings,"Refresh pass ownership / price",UDim2.new(1,0,0,44),UDim2.fromOffset(0,640),function()
		self.priceId=nil;self.price=nil;request("RefreshPass")
	end)
	label("PassEffect",settings,"Marks called matching numbers only. Manual marking is free. Cards, draws, multipliers and bonus odds do not change.",UDim2.new(1,0,0,80),UDim2.fromOffset(0,692),13)
	function self:show(name)
		for key,frame in pairs(self.pages) do frame.Visible=key==name end
	end
	function self:render(state)
		self.state=state
		for _,item in ipairs(config.Catalog) do
			if item.category=="pet" then
				petButtons[item.id].Text=item.name.." · "..(if state.equipped.pet==item.id then "Equipped" elseif state.owned[item.id] then "Equip · owned" else item.price.." Pesos")
			end
		end
		local pass=state.pass
		if pass then
			if pass.configured and self.priceId~=pass.id then
				self.priceId,self.price=pass.id,nil
				task.spawn(function()
					local ok,info=pcall(function() return Marketplace:GetProductInfoAsync(pass.id,Enum.InfoType.GamePass) end)
					if self.priceId~=pass.id then return end
					self.price=if ok and info.IsForSale and type(info.PriceInRobux)=="number" then info.PriceInRobux else nil
					self:render(self.state)
				end)
			end
			buy.Text=if pass.owned then "Owned" elseif not pass.configured then "Pass ID not configured" elseif self.price then "Buy · "..self.price.." Robux" else "Platform price unavailable"
			passStatus.Text=pass.status..(if self.price and self.price~=pass.intendedPrice then "\nPrice differs from intended "..pass.intendedPrice.." Robux (regional pricing may apply)." else "\nIntended price: "..pass.intendedPrice.." Robux. Roblox confirms the final price.")
			toggle.Text="Auto Mark · "..(if state.settings.autoMark and pass.owned then "On" else "Off")..(if not pass.owned then " · pass required" else "")
		end
		local status=state.chest
		if status then
			chestStatus.Text=if not status.configured then status.reason elseif status.canClaim then "Your free chest is ready." else "Next claim: "..os.date("!%d %b %H:%M UTC",status.readyAt)
			claim.Text=if status.canClaim then "Claim free chest" elseif status.configured then "On cooldown" else "Rules pending"
		end
		local payout=state.topPayout
		if payout then
			local winner=payout.leader
			top.Text=if winner then winner.playerName.." · "..winner.pesos.." Pesos\n"..winner.source.." · "..winner.multiplier.."×\n"..os.date("!%d %b %H:%M:%S UTC",winner.at).."\n"..payout.status
				elseif string.sub(payout.status,1,7)=="Updated" then "No qualifying payouts in the last 24 hours." else payout.status
		end
		local lines={}
		for _,event in ipairs(state.recentBonuses or {}) do
			table.insert(lines,event.name.." · "..os.date("!%H:%M:%S UTC",event.at))
			for _,result in ipairs(event.results) do
				table.insert(lines,result.playerName.." · "..result.multiplier.."× · "..(if result.pesos>0 then "+" else "")..result.pesos.." Pesos")
			end
			table.insert(lines,"")
		end
		recent.Text=if #lines>0 then table.concat(lines,"\n") else "No completed bonus events yet."
		for _,message in ipairs(state.systemMessages or {}) do
			if message.serial>self.seenSerial then
				self.seenSerial=message.serial
				if os.time()-message.at<=30 then table.insert(self.queue,message.text) end
			end
		end
		while #self.queue>12 do table.remove(self.queue,1) end
	end
	function self:update(now)
		if #self.queue==0 or now<self.nextMessage then return end
		local channels=TextChatService:FindFirstChild("TextChannels")
		local channel=channels and (channels:FindFirstChild("RBXSystem") or channels:FindFirstChild("RBXGeneral"))
		if not channel then return end
		local message=table.remove(self.queue,1)
		local escaped=string.gsub(string.gsub(string.gsub(message,"&","&amp;"),"<","&lt;"),">","&gt;")
		channel:DisplaySystemMessage("[Cloudpop System] "..escaped)
		self.nextMessage=now+5
	end
	return self
end
return Features
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="31">
        <Properties>
          <string name="Name">GameClient</string>
          <string name="Source"><![CDATA[-- Compact HUD. Roblox owns the avatar, camera, chat, movement and backpack controls.
local gui = script.Parent
local status = gui:FindFirstChild("StartupStatus")
if status then status.Text = "Opening Cloudpop…" end
local function initialize()
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local function waitFor(parent, name)
		local child = parent:WaitForChild(name, 15)
		assert(child, "Timed out waiting for " .. parent:GetFullName() .. "." .. name)
		return child
	end
	local shared = waitFor(ReplicatedStorage, "Cloudpop")
	local Config = require(waitFor(shared, "Config"))
	local Economy = require(waitFor(shared, "Economy"))
	local audio
	local effects = require(waitFor(gui, "WorldEffects")).new()
	local remotes = waitFor(shared, "Remotes")
	local action, stateEvent = waitFor(remotes, "Action"), waitFor(remotes, "State")
	local colors = {
		navy = Color3.fromRGB(16, 30, 53), panel = Color3.fromRGB(24, 47, 78), blue = Color3.fromRGB(47, 84, 125),
		ice = Color3.fromRGB(226, 242, 255), muted = Color3.fromRGB(164, 190, 215), cyan = Color3.fromRGB(99, 222, 240),
	}
	local function make(class, name, parent, properties)
		local object = Instance.new(class)
		object.Name = name
		for key, value in pairs(properties or {}) do object[key] = value end
		object.Parent = parent
		return object
	end
	local function round(object, radius)
		make("UICorner", "Corners", object, { CornerRadius = UDim.new(0, radius or 10) })
	end
	local function frame(name, parent, size, position)
		local object = make("Frame", name, parent, { Size = size, Position = position or UDim2.fromOffset(0, 0), BackgroundColor3 = colors.panel, BorderSizePixel = 0 })
		round(object)
		return object
	end
	local function label(name, parent, text, size, position, fontSize)
		return make("TextLabel", name, parent, { Text = text, Size = size, Position = position, BackgroundTransparency = 1,
			TextColor3 = colors.ice, TextSize = fontSize or 16, Font = Enum.Font.GothamMedium, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left })
	end
	local function button(name, parent, text, size, position, callback)
		local object = make("TextButton", name, parent, { Text = text, Size = size, Position = position,
			BackgroundColor3 = colors.blue, TextColor3 = colors.ice, TextSize = 14, Font = Enum.Font.GothamBold,
			BorderSizePixel = 0, AutoButtonColor = true })
		round(object, 8)
		object.Activated:Connect(callback)
		return object
	end
	local touch = game:GetService("UserInputService").TouchEnabled
	local layout = require(waitFor(shared, "CardLayout"))
	local manifest = require(waitFor(shared, "AudioManifest"))
	-- Audio receives only the consenting-human recording manifest; there is no speech synthesis.
	audio = require(waitFor(gui, "AudioController")).new(Config.Audio, manifest)
	local state, panelOpen, auxiliary = nil, not touch, nil
	local previousRound, previousCount, previousQualified = nil, 0, {}
	local function request(name, a, b, c)
		action:FireServer(name, a, b, c, if state then state.roundId else 0)
	end
	local hud = frame("HUD", gui, UDim2.fromOffset(330,90), UDim2.new(0.5,0,0,8))
	hud.AnchorPoint = Vector2.new(0.5,0)
	local ball = label("CurrentBall",hud,"—",UDim2.fromOffset(64,60),UDim2.fromOffset(8,0),32)
	ball.TextXAlignment=Enum.TextXAlignment.Center
	local counter = label("DrawCount",hud,"0 / 20",UDim2.fromOffset(114,24),UDim2.fromOffset(82,6),18)
	local balance = label("Pesos",hud,"0 Pesos",UDim2.fromOffset(220,22),UDim2.fromOffset(82,30),14)
	local history = label("RecentBalls",hud,"Fresh pool · 1–60",UDim2.new(1,-20,0,18),UDim2.fromOffset(10,64),12)
	local phaseText = label("Phase",hud,"Connecting…",UDim2.fromOffset(126,24),UDim2.fromOffset(195,6),14)
	phaseText.TextXAlignment=Enum.TextXAlignment.Right
	local subtitles=label("PresenterSubtitle",gui,"",UDim2.fromOffset(420,38),UDim2.new(0.5,0,0,104),15)
	subtitles.AnchorPoint,subtitles.BackgroundColor3,subtitles.BackgroundTransparency=Vector2.new(0.5,0),colors.navy,0.1
	subtitles.TextXAlignment,subtitles.Visible=Enum.TextXAlignment.Center,false
	round(subtitles)
	local toast=label("Notice",gui,"",UDim2.fromOffset(330,40),UDim2.new(0.5,0,0,150),13)
	toast.AnchorPoint,toast.BackgroundColor3,toast.BackgroundTransparency=Vector2.new(0.5,0),colors.navy,0.1
	toast.Visible=false
	round(toast)
	local noticeUntil=0
	local function notify(text)
		toast.Text,toast.Visible=text,true
		noticeUntil=workspace:GetServerTimeNow()+5
	end
	local cardPanel=require(waitFor(gui,"CardPanel")).new(gui,{frame=frame,label=label,button=button,make=make,colors=colors},Config,layout,request)
	local aux=frame("AuxiliaryPanel",gui,UDim2.fromOffset(350,370),UDim2.new(0.5,0,1,-80))
	aux.AnchorPoint,aux.Visible=Vector2.new(0.5,1),false
	local auxTitle=label("Title",aux,"SETTINGS",UDim2.new(1,-70,0,44),UDim2.fromOffset(12,0),16)
	local body=make("ScrollingFrame","Body",aux,{Size=UDim2.new(1,-20,1,-100),Position=UDim2.fromOffset(10,94),CanvasSize=UDim2.fromOffset(0,420),
		ScrollBarThickness=4,BackgroundTransparency=1,BorderSizePixel=0,ScrollingDirection=Enum.ScrollingDirection.Y})
	local settings=make("Frame","Settings",body,{Size=UDim2.new(1,-6,0,780),BackgroundTransparency=1})
	local looks=make("Frame","Looks",body,{Size=UDim2.new(1,-6,0,340),BackgroundTransparency=1})
	local resize,render
	local compactPresentation=false
	button("Close",aux,"×",UDim2.fromOffset(44,40),UDim2.new(1,-50,0,2),function() auxiliary=nil; resize() end)
	local function openCards()
		panelOpen,auxiliary=true,nil
		request("Participate")
		resize()
	end
	local cardsButton=button("CardsButton",gui,"Cards",UDim2.fromOffset(88,44),UDim2.fromOffset(0,0),function()
		if panelOpen and not auxiliary then panelOpen=false; resize() else openCards() end
	end)
	local looksButton=button("LooksButton",gui,"Shop",UDim2.fromOffset(88,44),UDim2.fromOffset(0,0),function() auxiliary="Looks"; resize() end)
	local settingsButton=button("SettingsButton",gui,"Settings",UDim2.fromOffset(88,44),UDim2.fromOffset(0,0),function() auxiliary="Settings"; resize() end)
	local reduced=button("reducedMotion",settings,"Reduced motion · Off",UDim2.new(1,0,0,44),UDim2.fromOffset(0,0),function()
		if state then request("Setting","reducedMotion",not state.settings.reducedMotion) end
	end)
	local volumes,mutes,previousVolumes={},{},{}
	for index,entry in ipairs({{"musicVolume","Music"},{"voiceVolume","Voice"},{"sfxVolume","Effects"}}) do
		local key,title,y=entry[1],entry[2],52+(index-1)*62
		volumes[key]=label(key,settings,title,UDim2.new(1,-172,0,44),UDim2.fromOffset(0,y),14)
		for _,delta in ipairs({-0.1,0.1}) do
			button(key..tostring(delta),settings,if delta<0 then "−" else "+",UDim2.fromOffset(44,44),UDim2.new(1,if delta<0 then -162 else -112,0,y),function()
				if state then request("Setting",key,math.clamp(math.floor(((state.settings[key] or 0)+delta)*10+0.5)/10,0,1)) end
			end)
		end
		mutes[key]=button(key.."Mute",settings,"Mute",UDim2.fromOffset(62,44),UDim2.new(1,-62,0,y),function()
			if not state then return end
			local current=state.settings[key] or 0
			if current>0 then previousVolumes[key]=current; request("Setting",key,0)
			else request("Setting",key,previousVolumes[key] or 0.5) end
		end)
	end
	local saveLabel=label("SaveStatus",settings,"",UDim2.new(1,0,0,56),UDim2.fromOffset(0,245),12)
	label("Credits",settings,"Created by Kikapucchino",UDim2.new(1,0,0,28),UDim2.fromOffset(0,308),13)
	label("AudioSlots",settings,"Human voice and music recordings are awaiting licensed audio.",UDim2.new(1,0,0,54),UDim2.fromOffset(0,342),12)
	local features=require(waitFor(gui,"FeaturePanels")).new(body,settings,{make=make,label=label,button=button},Config,request)
	require(waitFor(gui,"PetEffects")).start(function() return state and state.settings.reducedMotion end)
	for index,name in ipairs({"Looks","Pets","Settings","Chest","Records"}) do
		button("Tab"..name,aux,name,UDim2.new(0.2,-4,0,44),UDim2.new((index-1)*0.2,2,0,46),function() auxiliary=name;body.CanvasPosition=Vector2.new(0,0);resize() end).TextSize=11
	end
	local cosmeticButtons={}
	local index=0
	for _,item in ipairs(Config.Catalog) do
		if item.category=="pet" then continue end
		index+=1
		cosmeticButtons[item.id]=button(item.id,looks,item.name,UDim2.new(1,0,0,48),UDim2.fromOffset(0,(index-1)*56),function() request("Cosmetic",item.id) end)
	end
	local function cosmeticColor(category,fallback)
		local item=state and Economy.find(Config.Catalog,state.equipped[category])
		return if item then Color3.fromRGB(table.unpack(item.color)) else fallback
	end
	resize=function()
		local viewport=gui.AbsoluteSize
		local geometry=cardPanel:resize(viewport.X,viewport.Y,touch)
		cardPanel.root.Visible=panelOpen and auxiliary==nil
		aux.Visible=auxiliary~=nil
		settings.Visible,looks.Visible=auxiliary=="Settings",auxiliary=="Looks"
		features:show(auxiliary)
		auxTitle.Text=if auxiliary then string.upper(auxiliary) else ""
		aux.Size=UDim2.fromOffset(math.min(350,geometry.width),geometry.height)
		aux.Position=UDim2.new(0.5,0,1,-geometry.footer)
		compactPresentation=(cardPanel.root.Visible or aux.Visible) and viewport.Y-geometry.footer-geometry.height<235
		hud.Visible=not compactPresentation
		subtitles.Position=UDim2.new(0.5,0,0,if compactPresentation then 8 else 104)
		body.CanvasSize=UDim2.fromOffset(0,if auxiliary=="Looks" then 340 elseif auxiliary=="Settings" then 780 else features.heights[auxiliary] or 340)
		local bottom=geometry.footer+(if cardPanel.root.Visible or aux.Visible then geometry.height+48 else 48)
		for index,item in ipairs({cardsButton,looksButton,settingsButton}) do item.Position=UDim2.new(0.5,-138+(index-1)*94,1,-bottom) end
		hud.Size=UDim2.fromOffset(math.min(330,viewport.X-20),90)
		subtitles.Size=UDim2.fromOffset(math.min(420,viewport.X-24),38)
	end
	render=function()
		if not state then return end
		ball.Text=tostring(state.history[#state.history] or "—")
		counter.Text,balance.Text=#state.history.." / "..state.drawCount,tostring(state.pesos).." Pesos"
		local recent={}
		for index=math.max(1,#state.history-5),#state.history do table.insert(recent,tostring(state.history[index])) end
		history.Text=if #recent>0 then "Recent · "..table.concat(recent," · ") else "Fresh pool · 1–60"
		cardPanel:render(state,cosmeticColor("card",colors.ice),cosmeticColor("marker",colors.cyan))
		reduced.Text="Reduced motion · "..(if state.settings.reducedMotion then "On" else "Off")
		for key,view in pairs(volumes) do
			local title=if key=="musicVolume" then "Music" elseif key=="voiceVolume" then "Voice" else "Effects"
			local value=state.settings[key] or 0
			view.Text=title.." "..math.floor(value*100+0.5).."%"
			mutes[key].Text=if value>0 then "Mute" else "Unmute"
		end
		saveLabel.Text=(state.saveStatus or "")..(if state.practice then "\nStudio practice · progress is temporary" else "")
		features:render(state)
		for _,item in ipairs(Config.Catalog) do
			if item.category=="pet" then continue end
			local suffix=if state.equipped[item.category]==item.id then "Equipped" elseif state.owned[item.id] then "Equip" else item.price.." Pesos"
			cosmeticButtons[item.id].Text=item.name.." · "..suffix
		end
	end
	stateEvent.OnClientEvent:Connect(function(snapshot)
		if previousRound~=snapshot.roundId then previousCount,previousQualified=0,{} end
		if #snapshot.history>previousCount then audio:play("draw") end
		for _,bonus in ipairs(snapshot.bonuses) do
			if bonus.qualified and not previousQualified[bonus.id] then
				notify(bonus.name.." qualified · payout rules pending")
				audio:play("qualify")
				previousQualified[bonus.id]=true
			end
		end
		if snapshot.phase=="Results" and (not state or state.phase~="Results") and snapshot.summary then
			notify("Round complete · +"..snapshot.summary.total.." Pesos")
			audio:play("result")
		end
		if state and state.roundId==snapshot.roundId then
			local marked=false
			for index,current in ipairs(snapshot.cards) do
				local old=state.cards[index]
				for cellIndex,cell in ipairs(current.cells) do
					if old and old.cells[cellIndex] and cell.marked and not old.cells[cellIndex].marked then marked=true end
				end
			end
			if marked then audio:play("mark") end
		end
		previousRound,previousCount,state=snapshot.roundId,#snapshot.history,snapshot
		audio:setVolumes(state.settings)
		audio:setTrack(state.activeBonus or "lobby")
		-- The same authoritative snapshot reveals the ball and queues its matching voice/subtitle.
		audio:announce(state.announcement,workspace:GetServerTimeNow())
		effects:update(state)
		if state.notice then notify(state.notice) end
		if status then status.Visible=false end
		render()
	end)
	local player=Players.LocalPlayer
	local function bindCharacter(character)
		character.ChildAdded:Connect(function(child) if child:IsA("Tool") and child.Name=="Cards" then openCards() end end)
		if character:FindFirstChild("Cards") then openCards() end
	end
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then bindCharacter(player.Character) end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	resize()
	RunService.RenderStepped:Connect(function()
		local now=workspace:GetServerTimeNow()
		features:update(now)
		if auxiliary=="Records" then body.CanvasSize=UDim2.fromOffset(0,math.max(820,246+features.recordsText.AbsoluteSize.Y+12)) end
		if state then
			local seconds=math.max(0,math.ceil(state.deadline-now))
			if state.phase=="Intermission" then cardPanel:setStatus("Starts in "..seconds.."s") end
			phaseText.Text=if state.phase=="Intermission" then "Starts in "..seconds elseif state.phase=="Drawing" then "DRAWING" elseif state.phase=="Results" then "RESULTS · "..seconds elseif state.phase=="Bonus" then "BONUS" else state.phase
		end
		local caption=audio:update(now)
		local noticeActive=now<noticeUntil
		if compactPresentation and caption=="" and noticeActive then caption=toast.Text end
		subtitles.Text,subtitles.Visible=caption,caption~=""
		toast.Visible=noticeActive and not compactPresentation
	end)
	request("Sync")
	if status then status.Visible=false end
	task.spawn(function()
		local attempts=0
		while not state do
			task.wait(3)
			if not state then
				request("Sync"); attempts+=1
				if attempts>=5 and status then status.Text="Waiting for the server. Check Studio Output for a startup or save-load error."; status.Visible=true end
			end
		end
	end)
end
local ok,problem=xpcall(initialize,debug.traceback)
if not ok then
	warn("Cloudpop client startup: "..tostring(problem))
	if status then status.Text="Cloudpop couldn't finish opening.\n"..tostring(problem):match("[^\n]+"); status.Visible=true end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PetEffects</string>
          <string name="Source"><![CDATA[-- Local visual interpolation of server-owned pets; no per-frame network updates or physics.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Pets={}
function Pets.start(reducedMotion)
	local pivots={}
	local elapsed=0
	RunService.RenderStepped:Connect(function(delta)
		elapsed+=delta
		if elapsed<1/30 then return end
		delta=elapsed;elapsed=0
		local folder=workspace:FindFirstChild("CloudpopPets")
		if not folder then return end
		local present={}
		for _,model in ipairs(folder:GetChildren()) do
			present[model]=true
			local ownerId=model:GetAttribute("OwnerUserId")
			local owner=if type(ownerId)=="number" then Players:GetPlayerByUserId(ownerId) else nil
			local root=owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
			if not root then continue end
			local moving=root.AssemblyLinearVelocity.Magnitude>1
			local t=workspace:GetServerTimeNow()
			local bob=if reducedMotion() then 0 else math.sin(t*(if moving then 8 else 2.5))*0.14
			local target=root.CFrame*CFrame.new(3,0.1+bob,3)*CFrame.Angles(0,0,if reducedMotion() then 0 else math.sin(t*3)*0.06)
			local nextPivot=if pivots[model] then pivots[model]:Lerp(target,1-math.exp(-10*math.min(delta,0.1))) else target
			pivots[model]=nextPivot
			model:PivotTo(nextPivot)
		end
		for model in pairs(pivots) do if not present[model] then pivots[model]=nil end end
	end)
end
return Pets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">WorldEffects</string>
          <string name="Source"><![CDATA[-- Cosmetic-only local animation: sixteen anchored balls, capped at 30 updates/sec.
-- Server snapshots control the displayed draw; this module never selects an outcome.
local RunService = game:GetService("RunService")
local Effects = {}
function Effects.new()
	local state, previousCount, elapsed, drawAt = nil, 0, 0, -100
	local balls, emerged, display, viewing, lastSecond
	local self = {}
	function self:update(snapshot)
		if snapshot.roundId ~= (state and state.roundId) then previousCount = 0 end
		if #snapshot.history > previousCount then
			drawAt = workspace:GetServerTimeNow()
			previousCount = #snapshot.history
		end
		state = snapshot
	end
	RunService.RenderStepped:Connect(function(delta)
		elapsed += delta
		if elapsed < 1 / 30 or not state then return end
		elapsed = 0
		if not balls then
			local model = workspace:FindFirstChild("CloudpopWorkshop")
			if not model then return end
			balls = {}
			for index = 1, 16 do
				local ball = model:FindFirstChild("DecorativeBall" .. index)
				if ball then table.insert(balls, ball) end
			end
			if #balls ~= 16 then balls = nil; return end
			emerged = model:FindFirstChild("DrawnBall")
			display,viewing=model:FindFirstChild("DrawDisplay"),model:FindFirstChild("ViewingDisplay")
		end
		local now = workspace:GetServerTimeNow()
		if state.phase == "Intermission" then
			local seconds = math.max(0,math.ceil(state.deadline-now))
			if seconds ~= lastSecond then
				for _,screen in ipairs({display,viewing}) do
					if screen then screen.Readout.Text.Text="NEXT ROUND IN "..seconds.."\n0 / 20" end
				end
				lastSecond=seconds
			end
		else lastSecond=nil end
		local reduced = state.settings.reducedMotion
		local moving = state.phase == "Drawing" and not reduced
		local time = if moving then now else 0
		for index, ball in ipairs(balls) do
			local angle = index * math.pi / 8 + time * (0.6 + index % 3 * 0.1)
			ball.Position = Vector3.new(math.cos(angle) * 3, 8.7 + math.sin(time * 1.8 + index * 1.7) * 2.1, -24 + math.sin(angle) * 3)
		end
		if emerged then
			local progress = math.clamp((now - drawAt) / 0.8, 0, 1)
			emerged.Position = Vector3.new(0, 6 + (if reduced then 0 else math.sin(progress * math.pi) * 3), -17)
		end
	end)
	return self
end
return Effects
]]></string>
        </Properties>
      </Item>
