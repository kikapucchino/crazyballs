      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[local Economy = {}

function Economy.defaults()
	return {
		version = 1,
		pesos = 0,
		rounds = 0,
		owned = { marker_sun = true, card_cloud = true },
		equipped = { marker = "marker_sun", card = "card_cloud" },
		settings = { autoMark = false, reducedMotion = false, musicVolume = 0.5, sfxVolume = 0.7 },
	}
end

function Economy.find(catalog, id)
	for _, item in ipairs(catalog) do
		if item.id == id then
			return item
		end
	end
	return nil
end

local function nonnegativeInteger(value)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return 0
	end
	return math.clamp(math.floor(value), 0, 1000000000)
end

function Economy.normalize(raw, catalog)
	local profile = Economy.defaults()
	if type(raw) ~= "table" then
		return profile
	end
	profile.pesos = nonnegativeInteger(raw.pesos)
	profile.rounds = nonnegativeInteger(raw.rounds)
	for _, item in ipairs(catalog) do
		if type(raw.owned) == "table" and raw.owned[item.id] == true then
			profile.owned[item.id] = true
		end
	end
	for _, category in ipairs({ "marker", "card" }) do
		local id = if type(raw.equipped) == "table" then raw.equipped[category] else nil
		local item = Economy.find(catalog, id)
		if item and item.category == category and profile.owned[id] then
			profile.equipped[category] = id
		end
	end
	if type(raw.settings) == "table" then
		profile.settings.autoMark = raw.settings.autoMark == true
		profile.settings.reducedMotion = raw.settings.reducedMotion == true
		for _, key in ipairs({ "musicVolume", "sfxVolume" }) do
			local value = raw.settings[key]
			if type(value) == "number" and value == value and math.abs(value) < math.huge then
				profile.settings[key] = math.clamp(value, 0, 1)
			end
		end
	end
	return profile
end

function Economy.purchase(profile, catalog, id)
	if type(id) ~= "string" then
		return false, "Unknown item."
	end
	local item = Economy.find(catalog, id)
	if not item then
		return false, "Unknown item."
	end
	if profile.owned[id] then
		profile.equipped[item.category] = id
		return true, item.name .. " equipped."
	end
	if profile.pesos < item.price then
		return false, "Save " .. (item.price - profile.pesos) .. " more Pesos for " .. item.name .. "."
	end
	profile.pesos -= item.price
	profile.owned[id] = true
	profile.equipped[item.category] = id
	return true, item.name .. " purchased and equipped."
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ExactInteger</string>
          <string name="Source"><![CDATA[-- Exact signed decimal arithmetic for bonus calculations. Never convert large values to doubles.
-- 1024 digits is a storage/resource guard, NOT a Go CRazy prize-design cap.
local Exact = { MaxDigits = 1024 }
function Exact.normalize(value)
	assert(type(value) == "string" and #value <= Exact.MaxDigits + 1, "Decimal string required (up to 1024 digits)")
	assert(string.match(value, "^%-?%d+$"), "Integer multiplier required; fractional rules are not configured")
	local negative = string.sub(value, 1, 1) == "-"
	local digits = if negative then string.sub(value, 2) else value
	digits = string.gsub(digits, "^0+", "")
	if digits == "" then return "0" end
	assert(#digits <= Exact.MaxDigits, "Decimal resource limit exceeded")
	return (if negative then "-" else "") .. digits
end
function Exact.multiplySmall(value, factor)
	value = Exact.normalize(value)
	assert(type(factor) == "number" and factor % 1 == 0 and factor >= 0 and factor <= 1000000, "Invalid base amount")
	local negative = string.sub(value, 1, 1) == "-"
	local digits = if negative then string.sub(value, 2) else value
	local result, carry = {}, 0
	for index = #digits, 1, -1 do
		local product = tonumber(string.sub(digits, index, index)) * factor + carry
		table.insert(result, tostring(product % 10))
		carry = math.floor(product / 10)
	end
	while carry > 0 do table.insert(result, tostring(carry % 10)); carry = math.floor(carry / 10) end
	local reversed = {}
	for index = #result, 1, -1 do table.insert(reversed, result[index]) end
	return Exact.normalize((if negative then "-" else "") .. table.concat(reversed))
end
function Exact.format(value)
	value = Exact.normalize(value)
	local sign = if string.sub(value, 1, 1) == "-" then "−" else ""
	local digits = if sign ~= "" then string.sub(value, 2) else value
	if #digits > 15 then return sign .. string.sub(digits, 1, 1) .. "." .. string.sub(digits, 2, 4) .. "e+" .. (#digits - 1) end
	local reversed = string.reverse(digits)
	local groups = string.gsub(reversed, "(%d%d%d)", "%1,")
	return sign .. string.gsub(string.reverse(groups), "^,", "")
end
return Exact
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GameRules</string>
          <string name="Source"><![CDATA[-- Pure round rules. Randomness is injected by the server, never by a client.
local Rules = {}
function Rules.isIndex(value, maximum)
	return type(value) == "number" and value == value and value % 1 == 0 and value >= 1 and value <= maximum
end
function Rules.shuffle(count, random)
	local result = {}
	for value = 1, count do result[value] = value end
	for index = count, 2, -1 do
		local other = random(1, index)
		result[index], result[other] = result[other], result[index]
	end
	return result
end
function Rules.newCardState(config, random)
	local state = { cards = {}, marks = {}, bonuses = {}, participated = false, settled = false }
	-- A zero-card preview explicitly avoids inventing count/pattern/free-center rules.
	if config.Main.Confirmed then
		assert(Rules.isIndex(config.Main.Count, 8), "Confirm a main card count from 1 to 8")
		for index = 1, config.Main.Count do
			local deck, card = Rules.shuffle(config.NumberPool, random), {}
			for cell = 1, 25 do card[cell] = if cell == 13 and config.Main.FreeCenter then 0 else deck[cell] end
			state.cards[index], state.marks[index] = card, { [0] = true }
		end
	end
	for _, definition in ipairs(config.Bonuses) do
		local numbers, deck = {}, Rules.shuffle(config.NumberPool, random)
		for index = 1, definition.count do numbers[index] = deck[index] end
		state.bonuses[definition.id] = { numbers = numbers, progress = 0, qualified = false }
	end
	return state
end
function Rules.mark(state, drawn, cardIndex, cellIndex)
	if state.settled or not Rules.isIndex(cardIndex, #state.cards) or not Rules.isIndex(cellIndex, 25) then return false end
	local number = state.cards[cardIndex][cellIndex]
	if not drawn[number] or state.marks[cardIndex][number] then return false end
	state.marks[cardIndex][number], state.participated = true, true
	return true
end
function Rules.markAll(state, drawn)
	if state.settled then return end
	for index, card in ipairs(state.cards) do
		for _, number in ipairs(card) do
			if drawn[number] then state.marks[index][number] = true end
		end
	end
end
function Rules.qualify(state, drawn)
	local newlyQualified = {}
	for id, card in pairs(state.bonuses) do
		local progress = 0
		for _, number in ipairs(card.numbers) do if drawn[number] then progress += 1 end end
		card.progress = progress
		if #card.numbers > 0 and progress == #card.numbers and not card.qualified then
			card.qualified = true
			table.insert(newlyQualified, id)
		end
	end
	return newlyQualified
end
function Rules.settle(state, rewards)
	if state.settled then return nil end
	state.settled = true
	return { total = if state.participated then rewards.Participation else 0, bonusPending = true }
end
return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
