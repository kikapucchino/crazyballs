      <Item class="ModuleScript" referent="RBX3">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Shared presentation and tuning. The server owns every outcome.
return {
	Title = "Cloudpop Commons",
	DataStoreName = "CloudpopProfiles_v1",
	IntermissionSeconds = 12,
	DrawSeconds = 5,
	DrawCount = 18,
	EventAfterDraw = 8,
	EventSeconds = 18,
	ResultsSeconds = 12,
	NumberPool = 24,
	Rewards = { Participation = 20, Pattern = 15, Objective = 10 },
	Goals = {
		trail = { name = "Number trail", description = "Mark 5 different numbers", short = "5 different numbers" },
		twins = { name = "Double delivery", description = "Mark the same number on both cards", short = "One number on both cards" },
	},
	Catalog = {
		{ id = "marker_sun", name = "Sunbeam", category = "marker", price = 0, color = { 255, 199, 88 }, description = "A warm golden stamp" },
		{ id = "marker_berry", name = "Berry pop", category = "marker", price = 60, color = { 236, 128, 166 }, description = "A soft berry-pink stamp" },
		{ id = "marker_mint", name = "Mint breeze", category = "marker", price = 60, color = { 112, 222, 183 }, description = "A fresh mint-green stamp" },
		{ id = "card_cloud", name = "Cloud cream", category = "card", price = 0, color = { 255, 248, 232 }, description = "The original cream card" },
		{ id = "card_lilac", name = "Lilac post", category = "card", price = 150, color = { 233, 222, 252 }, description = "A lavender card frame" },
		{ id = "card_sea", name = "Sea glass", category = "card", price = 150, color = { 205, 240, 228 }, description = "A sea-green card frame" },
	},
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source">local Economy = {}

function Economy.defaults()
	return {
		version = 1,
		pesos = 0,
		rounds = 0,
		owned = { marker_sun = true, card_cloud = true },
		equipped = { marker = "marker_sun", card = "card_cloud" },
		settings = { autoMark = false, reducedMotion = false },
	}
end

function Economy.find(catalog, id)
	for _, item in ipairs(catalog) do
		if item.id == id then
			return item
		end
	end
	return nil
end

local function nonnegativeInteger(value)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return 0
	end
	return math.clamp(math.floor(value), 0, 1000000000)
end

function Economy.normalize(raw, catalog)
	local profile = Economy.defaults()
	if type(raw) ~= "table" then
		return profile
	end
	profile.pesos = nonnegativeInteger(raw.pesos)
	profile.rounds = nonnegativeInteger(raw.rounds)
	for _, item in ipairs(catalog) do
		if type(raw.owned) == "table" and raw.owned[item.id] == true then
			profile.owned[item.id] = true
		end
	end
	for _, category in ipairs({ "marker", "card" }) do
		local id = if type(raw.equipped) == "table" then raw.equipped[category] else nil
		local item = Economy.find(catalog, id)
		if item and item.category == category and profile.owned[id] then
			profile.equipped[category] = id
		end
	end
	if type(raw.settings) == "table" then
		profile.settings.autoMark = raw.settings.autoMark == true
		profile.settings.reducedMotion = raw.settings.reducedMotion == true
	end
	return profile
end

function Economy.purchase(profile, catalog, id)
	if type(id) ~= "string" then
		return false, "Unknown item."
	end
	local item = Economy.find(catalog, id)
	if not item then
		return false, "Unknown item."
	end
	if profile.owned[id] then
		profile.equipped[item.category] = id
		return true, item.name .. " equipped."
	end
	if profile.pesos &lt; item.price then
		return false, "Save " .. (item.price - profile.pesos) .. " more Pesos for " .. item.name .. "."
	end
	profile.pesos -= item.price
	profile.owned[id] = true
	profile.equipped[item.category] = id
	return true, item.name .. " purchased and equipped."
end

return Economy
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">GameRules</string>
          <ProtectedString name="Source">-- Engine-independent rules: also executed by tests/rules.spec.luau.
local Rules = {}

function Rules.isIndex(value, maximum)
	return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= 1 and value &lt;= maximum
end

function Rules.shuffle(count, nextInteger)
	local deck = {}
	for number = 1, count do
		deck[number] = number
	end
	for index = count, 2, -1 do
		local other = nextInteger(1, index)
		deck[index], deck[other] = deck[other], deck[index]
	end
	return deck
end

function Rules.newCardState(pool, nextInteger)
	local firstDeck = Rules.shuffle(pool, nextInteger)
	local secondDeck = Rules.shuffle(pool, nextInteger)
	local first, second = {}, { firstDeck[1] }
	for index = 1, 9 do
		first[index] = firstDeck[index]
	end
	-- At least one shared number makes Double Delivery possible on every pair.
	for _, number in ipairs(secondDeck) do
		if number ~= second[1] and #second &lt; 9 then
			table.insert(second, number)
		end
	end
	local positions = Rules.shuffle(9, nextInteger)
	local mixedSecond = {}
	for index, position in ipairs(positions) do
		mixedSecond[index] = second[position]
	end
	return {
		cards = { first, mixedSecond },
		marks = { {}, {} },
		claimed = { false, false },
		goal = "trail",
		participated = false,
		swapped = false,
		settled = false,
	}
end

function Rules.mark(state, drawn, cardIndex, cellIndex)
	if state.settled or not Rules.isIndex(cardIndex, 2) or not Rules.isIndex(cellIndex, 9) then
		return false
	end
	local number = state.cards[cardIndex][cellIndex]
	if not drawn[number] or state.marks[cardIndex][number] then
		return false
	end
	state.marks[cardIndex][number] = true
	state.participated = true
	return true
end

function Rules.markAll(state, drawn)
	-- Automatic marks don't count as an interaction for participation rewards.
	local participated = state.participated
	for cardIndex, card in ipairs(state.cards) do
		for cellIndex in ipairs(card) do
			Rules.mark(state, drawn, cardIndex, cellIndex)
		end
	end
	state.participated = participated
end

function Rules.claimPatterns(state)
	local newlyClaimed = 0
	for cardIndex, card in ipairs(state.cards) do
		if not state.claimed[cardIndex] then
			for row = 0, 2 do
				local offset = row * 3
				local marks = state.marks[cardIndex]
				if marks[card[offset + 1]] and marks[card[offset + 2]] and marks[card[offset + 3]] then
					state.claimed[cardIndex] = true
					newlyClaimed += 1
					break
				end
			end
		end
	end
	return newlyClaimed
end

function Rules.swap(state, cardIndex, firstIndex, secondIndex)
	if state.settled or state.swapped or not Rules.isIndex(cardIndex, 2)
		or not Rules.isIndex(firstIndex, 9) or not Rules.isIndex(secondIndex, 9) or firstIndex == secondIndex then
		return false
	end
	local card = state.cards[cardIndex]
	card[firstIndex], card[secondIndex] = card[secondIndex], card[firstIndex]
	-- Marks are keyed by number and therefore travel with their cells.
	state.swapped = true
	state.participated = true
	return true
end

function Rules.goalProgress(state)
	if state.goal == "twins" then
		for number in pairs(state.marks[1]) do
			if state.marks[2][number] then
				return 1, 1
			end
		end
		return 0, 1
	end
	local unique = {}
	for _, marks in ipairs(state.marks) do
		for number in pairs(marks) do
			unique[number] = true
		end
	end
	local count = 0
	for _ in pairs(unique) do
		count += 1
	end
	return math.min(count, 5), 5
end

function Rules.settle(state, rewards)
	if state.settled then
		return nil
	end
	state.settled = true
	local patterns = (if state.claimed[1] then 1 else 0) + (if state.claimed[2] then 1 else 0)
	local progress, target = Rules.goalProgress(state)
	-- A player must make at least one choice or valid manual mark this round.
	local participation = if state.participated then rewards.Participation else 0
	local patternReward = if state.participated then patterns * rewards.Pattern else 0
	local objective = if state.participated and progress == target then rewards.Objective else 0
	return { participation = participation, patterns = patternReward, objective = objective,
		total = participation + patternReward + objective }
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX7">
      <Properties>
        <string name="Name">CloudpopServer</string>
      </Properties>
      <Item class="Script" referent="RBX8">
        <Properties>
          <string name="Name">GameServer</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Cloudpop")
local Config = require(Shared.Config)
local Rules = require(Shared.GameRules)
local Economy = require(Shared.Economy)
local Profiles = require(script.Parent.ProfileStore)
require(script.Parent.Workshop).build()

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = Shared
local action = Instance.new("RemoteEvent")
action.Name = "Action"
action.Parent = remotes
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "State"
stateEvent.Parent = remotes

local rng = Random.new()
local function nextInteger(low, high) return rng:NextInteger(low, high) end
local profiles, boards, summaries, rateLimits, loading = {}, {}, {}, {}, {}
local round = { id = 0, phase = "Waiting", deadline = 0, history = {}, drawn = {} }
local closing = false

local function usable(player)
	return Profiles.writable(profiles[player])
end

local function changed(profile)
	profile.revision = (profile.revision or 0) + 1
	if not profile.practice then profile.saveStatus = "Changes waiting to save" end
end

local function send(player, notice)
	local profile = profiles[player]
	if not profile or player.Parent ~= Players then return end
	local board = boards[player]
	local cardViews = {}
	if board then
		for cardIndex, card in ipairs(board.cards) do
			local cells = {}
			for _, number in ipairs(card) do
				table.insert(cells, { number = number, marked = board.marks[cardIndex][number] == true,
					available = round.drawn[number] == true })
			end
			table.insert(cardViews, { cells = cells, complete = board.claimed[cardIndex] })
		end
	end
	local progress, target = 0, 5
	if board then progress, target = Rules.goalProgress(board) end
	-- Future draws and other players' profiles never leave the server.
	stateEvent:FireClient(player, {
		roundId = round.id, phase = round.phase, deadline = round.deadline,
		history = round.history, drawCount = Config.DrawCount, cards = cardViews,
		goal = if board then board.goal else "trail", goalProgress = progress, goalTarget = target,
		swapped = if board then board.swapped else false,
		participated = if board then board.participated else false,
		pesos = profile.data.pesos, rounds = profile.data.rounds,
		owned = profile.data.owned, equipped = profile.data.equipped, settings = profile.data.settings,
		saveStatus = profile.saveStatus, practice = profile.practice,
		players = #Players:GetPlayers(), summary = summaries[player], notice = notice,
	})
end

local function broadcast()
	for player in pairs(profiles) do send(player) end
end

local function checkPatterns(player)
	local count = Rules.claimPatterns(boards[player])
	if count &gt; 0 then
		send(player, "Row complete! +" .. count * Config.Rewards.Pattern .. " Pesos at round end.")
	end
end

local function settle(player)
	local board, profile = boards[player], profiles[player]
	if not board or not profile or not usable(player) then return end
	-- Choosing an objective and leaving before the first draw is not a played round.
	if #round.history == 0 then return end
	local summary = Rules.settle(board, Config.Rewards)
	if not summary then return end
	profile.data.pesos += summary.total
	if board.participated then profile.data.rounds += 1 end
	changed(profile)
	summaries[player] = summary
end

local function addPlayer(player)
	if profiles[player] or loading[player] or closing then return end
	loading[player] = true
	local profile, problem = Profiles.load(player)
	loading[player] = nil
	if not profile then
		if player.Parent == Players then player:Kick(problem) end
		return
	end
	if player.Parent ~= Players or closing then
		Profiles.close(profile)
		return
	end
	profiles[player] = profile
	if round.phase == "Intermission" then
		boards[player] = Rules.newCardState(Config.NumberPool, nextInteger)
	end
	broadcast()
end

local function removePlayer(player)
	local profile = profiles[player]
	if profile then
		-- Earned progress is settled even if a player leaves before the results screen.
		settle(player)
		Profiles.close(profile)
	end
	profiles[player], boards[player], summaries[player], rateLimits[player] = nil, nil, nil, nil
	broadcast()
end

action.OnServerEvent:Connect(function(player, name, a, b, c, requestedRound)
	if type(name) ~= "string" or not profiles[player] then return end
	local now = os.clock()
	local budget = rateLimits[player] or { tokens = 16, at = now }
	budget.tokens = math.min(16, budget.tokens + (now - budget.at) * 8)
	budget.at = now
	rateLimits[player] = budget
	if budget.tokens &lt; 1 then return end
	budget.tokens -= 1
	if name == "Sync" then send(player); return end
	if not usable(player) then send(player, "Saving is reconnecting. Please wait."); return end
	local profile, board = profiles[player], boards[player]
	local notice
	if name == "Cosmetic" then
		local bought, message = Economy.purchase(profile.data, Config.Catalog, a)
		if bought then changed(profile) end
		notice = message
	elseif name == "Setting" then
		if (a ~= "autoMark" and a ~= "reducedMotion") or type(b) ~= "boolean" then return end
		profile.data.settings[a] = b
		changed(profile)
		if board and not board.settled then
			board.participated = true
			if a == "autoMark" and b then
				Rules.markAll(board, round.drawn)
				checkPatterns(player)
			end
		end
	elseif board and requestedRound == round.id and not board.settled then
		if name == "Goal" and round.phase == "Intermission" and type(a) == "string" and Config.Goals[a] then
			board.goal = a
			board.participated = true
		elseif name == "Mark" and (round.phase == "Drawing" or round.phase == "Event" or round.phase == "LastCall") then
			if Rules.mark(board, round.drawn, a, b) then checkPatterns(player) end
		elseif name == "Swap" and round.phase == "Event" then
			if Rules.swap(board, a, b, c) then
				checkPatterns(player)
				notice = "Tailwind delivered! Your marks moved with their numbers."
			end
		elseif name == "Keep" and round.phase == "Event" and not board.swapped then
			board.swapped = true
			board.participated = true
			notice = "Layout kept. Enjoy the breeze!"
		end
	end
	send(player, notice)
end)

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(addPlayer, player) end

task.spawn(function()
	while not closing do
		task.wait(45)
		for player, profile in pairs(profiles) do
			if not profile.closing then
				task.spawn(function()
					Profiles.save(profile, false)
					if not profile.closing and not Profiles.writable(profile) then
						player:Kick("Your cloud save connection was interrupted. Please rejoin shortly.")
					else
						send(player)
					end
				end)
			end
		end
	end
end)

local function phase(name, seconds)
	round.phase = name
	round.deadline = workspace:GetServerTimeNow() + seconds
	broadcast()
	while not closing and workspace:GetServerTimeNow() &lt; round.deadline do task.wait(0.15) end
end

game:BindToClose(function()
	closing = true
	local remaining = 0
	for player, profile in pairs(profiles) do
		remaining += 1
		task.spawn(function()
			settle(player)
			Profiles.close(profile)
			remaining -= 1
		end)
	end
	local timeout = os.clock() + 25
	while (remaining &gt; 0 or next(loading)) and os.clock() &lt; timeout do task.wait(0.1) end
end)

while not closing do
	if next(profiles) == nil then
		round.phase = "Waiting"
		task.wait(1)
		continue
	end
	round.id += 1
	round.history, round.drawn = {}, {}
	boards, summaries = {}, {}
	for player in pairs(profiles) do
		if usable(player) then boards[player] = Rules.newCardState(Config.NumberPool, nextInteger) end
	end
	phase("Intermission", Config.IntermissionSeconds)
	local deck = Rules.shuffle(Config.NumberPool, nextInteger)
	for index = 1, Config.DrawCount do
		if closing then break end
		local number = deck[index]
		round.drawn[number] = true
		table.insert(round.history, number)
		for player, board in pairs(boards) do
			if usable(player) and profiles[player].data.settings.autoMark then
				Rules.markAll(board, round.drawn)
				checkPatterns(player)
			end
		end
		phase("Drawing", Config.DrawSeconds)
		if index == Config.EventAfterDraw then phase("Event", Config.EventSeconds) end
	end
	if closing then break end
	phase("LastCall", 8)
	for player in pairs(profiles) do settle(player) end
	phase("Results", Config.ResultsSeconds)
end
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">ProfileStore</string>
          <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Cloudpop")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local Store = {}
local database
local LEASE_SECONDS = 300

local function getDatabase()
	-- GetDataStore can itself fail in an unpublished place. Practice never calls it.
	if not database then database = DataStoreService:GetDataStore(Config.DataStoreName) end
	return database
end

local function retry(operation)
	for attempt = 1, 3 do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		warn("Cloudpop data request failed (attempt " .. attempt .. "). " .. tostring(result))
		if attempt &lt; 3 then
			task.wait(attempt * 2)
		end
	end
	return false, nil
end

function Store.load(player)
	-- Studio is deliberately session-only unless explicitly opted in on this module.
	-- Use a separate published TEST experience when enabling Studio saves.
	if RunService:IsStudio() and script:GetAttribute("EnableStudioSaves") ~= true then
		return { data = Economy.defaults(), practice = true, saveStatus = "Studio practice · not saved", closing = false }
	end
	local token = HttpService:GenerateGUID(false)
	local key = "player_" .. player.UserId
	local denial = "Profile is open on another server. Please retry shortly."
	local ok, record = retry(function()
		return getDatabase():UpdateAsync(key, function(old)
			if old ~= nil then
				if type(old) ~= "table" or type(old.data) ~= "table" or old.data.version ~= 1 then
					denial = "Your save needs a compatible game version. Please retry later."
					return nil
				end
				if type(old.lock) == "table" and old.lock.id ~= token
					and type(old.lock.expires) == "number" and old.lock.expires &gt; os.time() then
					return nil
				end
			end
			return {
				data = Economy.normalize(if old then old.data else nil, Config.Catalog),
				lock = { id = token, expires = os.time() + LEASE_SECONDS },
			}
		end)
	end)
	if not ok then
		return nil, "Cloud saves are unavailable. Please retry; your existing save has not been replaced."
	end
	if not record or not record.lock or record.lock.id ~= token then
		return nil, denial
	end
	return { data = record.data, key = key, token = token, expires = record.lock.expires,
		practice = false, saving = false, closing = false, saveStatus = "Cloud save connected" }
end

function Store.writable(profile)
	return profile and not profile.closing and (profile.practice or os.time() &lt; profile.expires - 30)
end

function Store.save(profile, release)
	if profile.practice then
		return true
	end
	while profile.saving do
		task.wait(0.1)
	end
	profile.saving = true
	local snapshot = Economy.normalize(profile.data, Config.Catalog)
	local snapshotRevision = profile.revision or 0
	local ok, result = retry(function()
		return getDatabase():UpdateAsync(profile.key, function(old)
			-- Never overwrite another server's session or resurrect a released lock.
			if type(old) ~= "table" or type(old.lock) ~= "table" or old.lock.id ~= profile.token then
				return nil
			end
			return { data = snapshot, lock = if release then nil else {
				id = profile.token, expires = os.time() + LEASE_SECONDS,
			} }
		end)
	end)
	profile.saving = false
	if ok and result then
		if not release then
			profile.expires = result.lock.expires
		end
		profile.saveStatus = if (profile.revision or 0) == snapshotRevision then "Progress saved" else "Changes waiting to save"
		return true
	end
	profile.saveStatus = "Save delayed · retrying"
	return false
end

function Store.close(profile)
	if profile.closing then
		while not profile.closed do task.wait(0.1) end
		return
	end
	profile.closing = true
	if not Store.save(profile, true) then
		warn("Cloudpop could not finish a profile save; its session lock will expire automatically.")
	end
	profile.closed = true
end

return Store
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">Workshop</string>
          <ProtectedString name="Source">-- A small original lobby made entirely from Roblox primitives; no external assets.
local Workshop = {}

function Workshop.build()
	if workspace:FindFirstChild("CloudpopWorkshop") then
		return
	end
	local model = Instance.new("Model")
	model.Name = "CloudpopWorkshop"
	model.Parent = workspace
	local function part(name, size, position, color, shape)
		local object = Instance.new("Part")
		object.Name = name
		object.Anchored = true
		object.Size = size
		object.Position = position
		object.Color = Color3.fromRGB(table.unpack(color))
		object.Material = Enum.Material.SmoothPlastic
		object.TopSurface = Enum.SurfaceType.Smooth
		object.BottomSurface = Enum.SurfaceType.Smooth
		if shape then object.Shape = shape end
		object.Parent = model
		return object
	end
	part("FloatingGarden", Vector3.new(90, 5, 70), Vector3.new(0, -3, 0), { 133, 193, 163 })
	part("WorkshopFloor", Vector3.new(62, 1, 44), Vector3.new(0, 0, 0), { 242, 223, 187 })
	for _, x in ipairs({ -29, 29 }) do
		for _, z in ipairs({ -20, 20 }) do
			part("Column", Vector3.new(2, 16, 2), Vector3.new(x, 8, z), { 79, 133, 132 })
		end
	end
	part("Canopy", Vector3.new(65, 2, 47), Vector3.new(0, 17, 0), { 243, 174, 131 })
	part("MachinePedestal", Vector3.new(12, 4, 10), Vector3.new(0, 2.5, -10), { 42, 112, 116 })
	local globe = part("AirChamber", Vector3.new(9, 9, 9), Vector3.new(0, 9, -10), { 177, 233, 227 }, Enum.PartType.Ball)
	globe.Transparency = 0.65
	globe.CanCollide = false
	for index = 1, 12 do
		local angle = index * math.pi / 6
		part("DecorativeBall", Vector3.new(1.4, 1.4, 1.4), Vector3.new(math.cos(angle) * 2.7, 7 + index % 4, -10 + math.sin(angle) * 2.7),
			if index % 2 == 0 then { 255, 199, 88 } else { 236, 128, 166 }, Enum.PartType.Ball).CanCollide = false
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "WelcomeMat"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 1, 6)
	spawn.Position = Vector3.new(0, 1, 12)
	spawn.Color = Color3.fromRGB(255, 199, 88)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Parent = model
	for index = 1, 4 do
		local x = if index % 2 == 0 then 19 else -19
		local z = if index &lt;= 2 then 5 else -9
		part("StampingStation", Vector3.new(8, 3, 5), Vector3.new(x, 2, z), { 255, 248, 232 })
	end
	local lighting = game:GetService("Lighting")
	lighting.ClockTime = 14
	lighting.Brightness = 2
	lighting.Ambient = Color3.fromRGB(160, 182, 191)
	workspace.FallenPartsDestroyHeight = -100
end

return Workshop
