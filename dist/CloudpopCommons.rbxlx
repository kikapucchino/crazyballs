      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">BonusRules</string>
          <string name="Source"><![CDATA[-- Pure server-side building blocks. No production distribution is configured yet.
-- An award receipt is a computed outcome, NOT a persisted balance mutation.
local Bonus = {}
function Bonus.validate(definition, outcomes)
	if type(outcomes) ~= "table" or #outcomes == 0 then return false end
	if definition.id == "crazy" then return false end -- wheel rules still need confirmation
	if definition.id == "coin" and #outcomes ~= 2 then return false end
	local total = 0
	for _, outcome in ipairs(outcomes) do
		local value, weight = outcome.multiplier, outcome.weight
		if type(value) ~= "number" or value ~= value or value % 1 ~= 0
			or value < definition.minimum or value > definition.maximum then return false end
		if type(weight) ~= "number" or weight % 1 ~= 0 or weight <= 0 or weight > 1000000 then return false end
		total += weight
	end
	return total <= 1000000000
end
function Bonus.choose(definition, outcomes, random)
	assert(Bonus.validate(definition, outcomes), "Unconfirmed/invalid bonus distribution")
	local total = 0
	for _, outcome in ipairs(outcomes) do total += outcome.weight end
	local roll = random(1, total)
	for index, outcome in ipairs(outcomes) do
		roll -= outcome.weight
		if roll <= 0 then return index end
	end
	error("Random source returned an invalid roll")
end
function Bonus.newLedger()
	return { common = {}, receipts = {} }
end
-- caller supplies a trusted eligibility boolean and SERVER random source.
-- Duck uses a server-owned shuffled mapping; disconnect/timeout passes nil selection.
function Bonus.resolve(ledger, userId, definition, outcomes, eligible, selection, random, exact, base)
	if not eligible then return nil end
	local key = tostring(userId) .. ":" .. definition.id
	if ledger.receipts[key] then return ledger.receipts[key], false end
	assert(Bonus.validate(definition, outcomes), "Bonus is not configured")
	local index
	if definition.shared then
		index = ledger.common[definition.id]
		if not index then index = Bonus.choose(definition, outcomes, random); ledger.common[definition.id] = index end
	else
		if selection ~= nil then
			if type(selection) ~= "number" or selection % 1 ~= 0 or selection < 1 or selection > #outcomes then return nil end
			index = selection
		else index = random(1, #outcomes) end
	end
	local multiplier = outcomes[index].multiplier
	local receipt = { index = index, multiplier = tostring(multiplier), pesos = exact.multiplySmall(tostring(multiplier), base) }
	ledger.receipts[key] = receipt
	return receipt, true
end
return Bonus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Public tuning only. Outcomes, decks, and hidden selections live on the server.
return {
	Title = "Cloudpop Commons",
	Build = "0.2.0",
	DataStoreName = "CloudpopProfiles_v1",
	IntermissionSeconds = 12,
	DrawSeconds = 4,
	DrawCount = 20,
	ResultsSeconds = 10,
	NumberPool = 60,
	-- Deliberately unconfigured: the requested main-card rules are awaiting answers.
	Main = { Count = 0, Grid = 5, FreeCenter = false, Patterns = {}, Confirmed = false },
	Rewards = { Participation = 20 }, -- Existing participation reward, not a bonus multiplier.
	BonusBasePesos = 20,
	Bonuses = {
		{ id = "coin", name = "Coin flip", count = 3, minimum = -50, maximum = 50, shared = true },
		{ id = "duck", name = "Duck hunt", count = 4, minimum = -100, maximum = 100, shared = false },
		{ id = "pacinki", name = "Pačinki", count = 4, minimum = -200, maximum = 200, shared = true },
		{ id = "crazy", name = "Go CRazy", count = 0, shared = true },
	},
	-- No distribution, timing, retrigger, or deduction policy is invented here.
	-- A future enablement must validate ALL of these and complete the policy review.
	BonusPayoutsEnabled = false,
	GoCRazy = { Segments = 64, PrizePointers = 3, Confirmed = false },
	Audio = {
		Music = { lobby = "", coin = "", duck = "", pacinki = "", crazy = "" },
		SFX = { draw = "", mark = "", qualify = "", reveal = "", result = "" },
	},
	Catalog = {
		{ id = "marker_sun", name = "Sunbeam", category = "marker", price = 0, color = { 255, 199, 88 }, description = "A warm golden stamp" },
		{ id = "marker_berry", name = "Berry pop", category = "marker", price = 60, color = { 236, 128, 166 }, description = "A berry-pink stamp" },
		{ id = "marker_mint", name = "Mint breeze", category = "marker", price = 60, color = { 112, 222, 183 }, description = "A mint-green stamp" },
		{ id = "card_cloud", name = "Cloud ice", category = "card", price = 0, color = { 222, 239, 255 }, description = "An icy blue card frame" },
		{ id = "card_lilac", name = "Lilac post", category = "card", price = 150, color = { 233, 222, 252 }, description = "A lavender card frame" },
		{ id = "card_sea", name = "Sea glass", category = "card", price = 150, color = { 174, 232, 240 }, description = "A sea-blue card frame" },
	},
}
]]></string>
        </Properties>
